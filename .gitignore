# Miscellaneous
*.class
*.log
*.pyc
*.swp

# Android signing keys — never commit
*.jks
*.keystore

# Store / signing credentials — never commit (Partner Center client secrets etc.)
*.cred.txt
store.cred.txt

# Store packaging build artifact (produced by `dart run msix:create`)
*.msix
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Node.js related
node_modules
.npm

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.prebuilt/
# Exception: the iOS ghostty-vt dylib is committed (built on macos-15, since the
# deploy runner's toolchain can't produce it). Re-include only that one file; the
# chain is required because git can't un-ignore a file under an ignored dir.
# See scripts/build-ghostty-ios.sh.
!/app/.prebuilt/
/app/.prebuilt/*
!/app/.prebuilt/ios-arm64/
/app/.prebuilt/ios-arm64/*
!/app/.prebuilt/ios-arm64/libghostty-vt.dylib
.flutter-plugins-dependencies
.pub-cache/
.pub/
/app/build/
/app/coverage/
/packages/*/build/
/packages/*/pubspec.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/app/android/app/debug
/app/android/app/profile
/app/android/app/release

# Local env files (per-service .env.example is committed)
.env
.env.local

# Dev-stack Antgrid home (ANTGRID_DIR): pairing/relay-epoch/session/auth state,
# isolated from an installed release app's ~/.antgrid. Lives at ~/.antgrid-dev
# by default (see hostDir() / scripts/dev.ts / aspire/apphost.ts) — outside the
# repo, so nothing to ignore here unless a developer points ANTGRID_DIR at a
# repo-local scratch dir.
.antgrid-dev/

# Worktrees and superpowers
.worktrees/
.superpowers/
.agents/

# Working plan/spec docs — author-local, not version-controlled
# (previously-committed plans under these paths stay tracked as-is)
docs/superpowers/plans/
docs/superpowers/specs/

# Generated plugin configs (created by bridge/plugin/setup.ts).
# NOTE: .claude/settings.json and .mcp.json are intentionally TRACKED
# (committed) so cloud sessions get enabledPlugins and the Dart MCP server at
# clone time — nothing runs `npm run setup` there to generate them. The plugin
# installer merges into both non-destructively (machine-local `hooks`, and the
# `antgrid` MCP entry), so the only local churn is its own keys appearing; if
# that is noisy, run `git update-index --skip-worktree <file>`.
.codex/
# Antigravity's `agy` keeps its per-project state here (and its global config
# under ~/.gemini) — the directory name is Gemini's, the agent is not.
.gemini/

# jscpd duplicate-detection HTML report (regenerate via `npm run dup-check`)
/.jscpd/

# Flutter desktop plugin registrants (regenerated by `flutter pub get`)
/app/linux/flutter/generated_plugin_registrant.cc
/app/linux/flutter/generated_plugin_registrant.h
/app/linux/flutter/generated_plugins.cmake
/app/macos/Flutter/GeneratedPluginRegistrant.swift
/app/windows/flutter/generated_plugin_registrant.cc
/app/windows/flutter/generated_plugin_registrant.h
/app/windows/flutter/generated_plugins.cmake
