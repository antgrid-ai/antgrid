{
  "path": ["bridge", "relay", "web", "packages", "app"],
  "minTokens": 50,
  "threshold": 3,
  "reporters": ["console", "html"],
  "output": ".jscpd",
  "absolute": true,
  "gitignore": true,
  "ignore": [
    "**/node_modules/**",
    "**/generated/**",
    "**/*.g.dart",
    "**/*.freezed.dart",
    "**/.dart_tool/**",
    "**/build/**",
    "**/dist/**",
    "**/.worktrees/**",
    "**/.claude/**",
    "**/app/android/**",
    "**/app/ios/**",
    "**/app/macos/**",
    "**/app/windows/**",
    "**/app/linux/**",
    "**/test/**",
    "**/tests/**",
    "**/*.test.ts",
    "**/*_test.dart"
  ]
}
