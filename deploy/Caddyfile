# Global options. The ACME email is used for Let's Encrypt registration and
# expiry notices. Caddy auto-provisions and auto-renews certs for every site
# address below — no manual cert handling.
{
	email ops@antgrid.ai
}

# The actual site blocks (app.antgrid.ai / relay.antgrid.ai -> live color)
# live in a snippet that deploy.sh rewrites on each flip. Importing it lets us
# swap upstreams and `caddy reload` gracefully (no dropped connections) instead
# of restarting Caddy.
import /etc/caddy/sites/*.caddy
