# Antgrid production env — copy to `.env` on the VM (/srv/antgrid/.env), fill in,
# and `chmod 600 .env`. Loaded by both colors via `env_file: .env`.
# This file is the ONLY place secrets live (no Key Vault / cloud secret store).
# NEVER commit the filled-in .env.

# ─── Shared ──────────────────────────────────────────────────────────────────
# Must be identical for relay and web; relay verifies the internal
# revoke/expire push from web with it. >=16 chars.
RELAY_INTERNAL_SECRET=

# ─── web ─────────────────────────────────────────────────────────────
# Managed Azure PostgreSQL Flexible Server, provisioned by OpenTofu (postgres.tf)
# — NOT run in Docker. Get this environment's value (it embeds the generated
# password) with:  cd infra/tofu && tofu output -raw pg_database_url
PG_DATABASE_URL=postgres://antgrid:pass@antgrid-<env>-pg.postgres.database.azure.com:5432/antgrid?sslmode=require

# >=16 chars. Better-Auth session signing secret.
BETTER_AUTH_SECRET=
# Public origin of web (used by Better-Auth for callbacks/cookies).
BETTER_AUTH_URL=https://app.antgrid.ai

# OAuth providers (Better-Auth sign-in).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (magic-link / cross-device sign-in). Optional but
# recommended in prod. ZeptoMail "Send Mail" token (bare key).
ZEPTOMAIL_TOKEN=
EMAIL_FROM=Antgrid <no-reply@radhaai.org>

# Comma-separated allowed CORS origins for the web.
CORS_ORIGINS=https://antgrid.ai,https://app.antgrid.ai

PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
IPINFO_TOKEN=

# ─── relay (optional tuning — sane defaults in relay/src/config.ts) ───────────
# LOG_LEVEL=info
# MAX_CONNECTIONS=10000
# RATE_LIMIT_CONN_PER_IP=10
# RATE_LIMIT_MSG_PER_SEC=100

# Note: PORT, LICENSE_API_URL, and RELAY_INTERNAL_URL are injected per-color by
# compose.app.yml — do NOT set them here.

# ─── errex (crash reporting — PRODUCTION VM ONLY) ─────────────────────────────
# One errex instance (on the prod VM) serves both environments via separate
# errex projects (antgrid-app vs antgrid-app-staging). deploy.sh only starts
# errex when DOMAIN=antgrid.ai, so these are unused on the staging box.
# Public origin of the errex dashboard/ingest. Defaults to https://errex.antgrid.ai
# in compose.errex.yml (the host hardcoded in caddy/sites/errex.caddy) — leave
# unset unless you forked the domain.
# ERREX_PUBLIC_URL=https://errex.antgrid.ai
# One-time setup-wizard secret. Generate with: openssl rand -hex 16
# Needed only to create the first admin at /setup; blank it after setup (the
# endpoint self-disables once any user exists).
ERREX_ADMIN_TOKEN=
