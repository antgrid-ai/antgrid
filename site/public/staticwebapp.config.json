{
  "trailingSlash": "auto",
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    { "route": "/download/started", "redirect": "/download", "statusCode": 301 },
    { "route": "/download/started/*", "redirect": "/download", "statusCode": 301 },
    { "route": "/_astro/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/og/*", "headers": { "Cache-Control": "public, max-age=86400" } }
  ],
  "mimeTypes": {
    ".txt": "text/plain",
    ".webmanifest": "application/manifest+json",
    ".svg": "image/svg+xml"
  }
}
