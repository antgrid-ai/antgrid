---
import Eyebrow from "../ui/Eyebrow.astro";
import { TRIAL_DAYS } from "../../data/pricing";
---
<div class="mb-8 text-center">
  <Eyebrow class="mb-3.5">Pricing</Eyebrow>
  <h1 class="mb-3 text-3xl font-medium tracking-tight text-ink">Local is free. Pay only to go remote.</h1>
  <p class="mx-auto max-w-xl text-[14.5px] leading-relaxed text-muted">
    Run as many agents as you want on your own machine, free forever. A paid plan adds encrypted remote control from your phone — start with a {TRIAL_DAYS}-day free trial.
  </p>
</div>
