---
import Eyebrow from "../ui/Eyebrow.astro";
import { BETA_FREE, TRIAL_DAYS, FREE_WORKERS, PRO_WORKERS } from "../../data/pricing";
---
<div class="mb-8 text-center">
  <Eyebrow class="mb-3.5">Pricing</Eyebrow>
  <h1 class="mb-3 text-3xl font-medium tracking-tight text-ink">Priced per person. Bring your own machines.</h1>
  <p class="mx-auto max-w-xl text-[14.5px] leading-relaxed text-muted">
    Every plan includes encrypted remote control from your phone. Pro is billed per seat — one per person on your team — and every seat runs agents on up to {PRO_WORKERS} machines of its own. No cloud sandboxes, no per-run metering. {BETA_FREE ? "During the beta, all of it is free." : `Start free on ${FREE_WORKERS} machine, or take Pro for a ${TRIAL_DAYS}-day trial.`}
  </p>
</div>
