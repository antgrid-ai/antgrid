---
import { Icon } from "astro-icon/components";
import Button from "../ui/Button.astro";
import { links } from "../../config";
---
<div class="mb-3.5 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-edge bg-panel px-5 py-4.5">
  <div class="min-w-0">
    <div class="mb-1 flex items-baseline gap-2.5">
      <span class="font-mono text-base font-medium text-ink">Free</span>
      <span class="text-xl font-medium text-ink">$0</span>
      <span class="text-xs text-muted2">local control, forever</span>
    </div>
    <div class="text-[12.5px] text-muted">Unlimited local agents · terminal, files &amp; git · Windows, macOS &amp; Linux · no card</div>
  </div>
  <Button href={links.startFree} variant="outline" class="px-4.5 py-2.5 text-[13px]">Start free<Icon name="tabler:arrow-right" width="14" height="14" /></Button>
</div>
