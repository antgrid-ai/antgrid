---
import { Icon } from "astro-icon/components";
import Button from "../ui/Button.astro";
import { links } from "../../config";
import type { PlanCardData } from "../../data/pricing";
interface Props { plan: PlanCardData }
const { plan } = Astro.props;
const discountPct = plan.listUsd ? Math.round((1 - plan.priceUsd / plan.listUsd) * 100) : null;
---
<div class={`flex flex-col rounded-lg border bg-panel p-5.5 ${plan.recommended ? "border-indigobtn" : "border-edge"}`}>
  <div class="mb-3 flex items-center gap-2">
    <span class="font-mono text-[15px] font-medium text-ink">{plan.name}</span>
    {plan.recommended && <span class="rounded bg-indigobtn px-1.5 py-0.5 font-mono text-[9.5px] font-medium text-white">RECOMMENDED</span>}
  </div>
  <div class="mb-1">
    <span class="text-3xl font-medium text-ink">${plan.priceUsd}</span>
    <span class="text-[13px] text-muted2"> {plan.unit}</span>
    {plan.listUsd && <span class="ml-2 text-sm text-faint line-through">${plan.listUsd}</span>}
    {discountPct && <span class="ml-1.5 rounded border border-indigodeep2 bg-indigodeep px-1.5 py-0.5 align-middle font-mono text-[9.5px] text-indigo2">{discountPct}% off launch</span>}
  </div>
  <div class="mb-4.5 text-xs text-muted2">{plan.note}</div>
  <div class="mb-5.5 flex flex-col gap-2.5 text-[12.5px] text-ink2">
    {plan.features.map((f) => (
      <span class="flex gap-2"><Icon name="tabler:check" class="shrink-0 text-indigo" width="15" height="15" />{f}</span>
    ))}
  </div>
  <div class="mt-auto">
    {plan.comingSoon ? (
      <button type="button" disabled class="inline-flex w-full cursor-not-allowed items-center justify-center gap-2 rounded-md border border-edge px-6 py-3 text-sm font-medium text-faint">Coming soon</button>
    ) : (
      <Button href={plan.ctaHref ?? links.checkout(plan.checkoutId ?? plan.id)} variant={plan.recommended ? "primary" : "outline"} class="w-full justify-center">{plan.cta}</Button>
    )}
    <div class="mt-2.5 text-center text-[11px] text-faint">{plan.ctaFooter}</div>
  </div>
</div>
