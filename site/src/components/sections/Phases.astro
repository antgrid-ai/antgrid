---
import Eyebrow from "../ui/Eyebrow.astro";

// Claims verified against antgrid@583e988: bridge/src/handler/{evidence,decision,engine}.ts.
// This example explains the mechanism without posing as a captured product run.
const handoff = [
  { title: "You hand over", body: '“Implement the plan, then review. Show passing tests. Ask me before changing the API.”' },
  { title: "Handler asks the agent", body: '“Show the test output before moving on.”' },
  { title: "Handler asks you", body: '“The fix needs an API change. Approve it or keep the current API?”' },
];

---
<section id="handler" class="reveal mx-auto max-w-shell px-6 py-16 md:py-20">
  <Eyebrow class="mb-5">Hand over the follow-ups</Eyebrow>
  <h2 class="mb-5 max-w-3xl font-display text-title font-semibold text-ink">Every phase has a checkpoint.<br />It doesn't have to be you.</h2>
  <p class="mb-8 max-w-2xl text-lede text-muted">
    Start a task with your coding agent. When you're ready, tell Handler what's left, how to proceed and when to ask you. It checks what the agent reports against your instructions and asks for evidence before moving on.
  </p>

  <p class="mb-4 text-meta text-muted2">Example instructions and follow-ups</p>
  <ol class="mb-7 grid gap-6 md:grid-cols-3">
    {handoff.map((step, i) => (
      <li class="card-lit rounded-lg border border-edge bg-group p-5">
        <div class="mb-3 font-mono text-meta text-signal">0{i + 1}</div>
        <h3 class="mb-2 text-note font-medium text-ink">{step.title}</h3>
        <p class="text-note leading-relaxed text-muted">{step.body}</p>
      </li>
    ))}
  </ol>
  {/* The limitation, on the page rather than in a code comment — a reader who
      assumes autonomy here and discovers otherwise has been mis-sold. */}
  <p class="mt-4 max-w-2xl text-meta leading-relaxed text-muted2">
    Handler works inside a session you arm. Review its decisions; its judgement can be wrong.
  </p>
  <a href="#download" class="mt-6 inline-flex items-center gap-2 text-note font-medium text-signal2 hover:text-signal">Try one handoff <span aria-hidden="true">↓</span></a>
</section>
