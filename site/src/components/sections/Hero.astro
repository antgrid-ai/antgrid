---
import { Icon } from "astro-icon/components";
import Eyebrow from "../ui/Eyebrow.astro";
import Button from "../ui/Button.astro";
import ProofCard from "./ProofCard.astro";
import { links } from "../../config";
import { BETA_FREE, OFFER_ACTIVE, YEARLY_OFFER_USD, YEARLY_LIST_USD } from "../../data/pricing";

const offerPct = Math.round((1 - YEARLY_OFFER_USD / YEARLY_LIST_USD) * 100);
---
<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 bg-dotgrid" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -top-40 right-[-10%] h-[560px] w-[720px] glow-indigo" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-shell px-6 pb-20 pt-16">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <div>
        <Eyebrow class="mb-4">Claude Code · Codex · Cursor</Eyebrow>
        {BETA_FREE ? (
          <a
            href={links.pricing}
            class="mb-5 inline-flex items-center gap-2 rounded-full border border-indigodeep2 bg-indigodeep/40 px-3 py-1 font-mono text-[11px] text-indigo2 transition-colors hover:border-indigobtn hover:text-indigo3"
          >
            <span class="rounded-full bg-indigobtn px-1.5 py-px text-[9.5px] font-medium text-white">beta</span>
            Free during beta — all Pro features included
            <Icon name="tabler:arrow-right" width="12" height="12" />
          </a>
        ) : OFFER_ACTIVE && (
          <a
            href={links.pricing}
            class="mb-5 inline-flex items-center gap-2 rounded-full border border-indigodeep2 bg-indigodeep/40 px-3 py-1 font-mono text-[11px] text-indigo2 transition-colors hover:border-indigobtn hover:text-indigo3"
          >
            <span class="rounded-full bg-indigobtn px-1.5 py-px text-[9.5px] font-medium text-white">{offerPct}% off</span>
            Launch offer — Pro ${YEARLY_OFFER_USD} per seat / year
            <Icon name="tabler:arrow-right" width="12" height="12" />
          </a>
        )}
        <h1 class="mb-5 font-medium leading-[1.1] tracking-tight text-ink">
          <span class="mb-2 block text-xl leading-snug text-muted md:text-2xl">Your agent finishes a phase at 2am and waits.</span>
          <span class="block text-5xl md:text-6xl">antgrid checks the work.<br />Then starts the next one.</span>
        </h1>
        <p class="mb-8 max-w-xl text-base leading-relaxed text-muted">
          Claude Code, Codex and Cursor on your own machines — your repos, your branches, your existing subscriptions. Hand antgrid the sequence in plain text: it reads each result, refuses a "done" that arrives with no test output, exit code or diff, and moves to the next phase — across every machine you own.
        </p>
        <div class="flex flex-wrap items-center gap-3">
          <Button href={links.startFree} variant="primary">Start free<Icon name="tabler:arrow-right" width="16" height="16" /></Button>
          <Button href={links.getStarted} variant="outline">Setup guide</Button>
        </div>
        <p class="mt-4 text-[12.5px] text-muted2">
          No VPN or port forwarding · End-to-end encrypted · Desktop out now, iOS &amp; Android coming to the App Store &amp; Play.
        </p>
      </div>
      {/* min-w-0 for the same reason as the Worktrees card — see the comment there. */}
      <div class="pc-animate min-w-0">
        <ProofCard />
      </div>
    </div>
  </div>
</section>
