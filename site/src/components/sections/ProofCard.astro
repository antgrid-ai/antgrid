---
import { Icon } from "astro-icon/components";
---
<div class="rounded-lg border border-edge bg-panel p-5">
  <div class="mb-4 flex items-center justify-between">
    <span class="text-sm font-medium text-ink">While you slept</span>
    <span class="font-mono text-xs text-muted2">kept moving 7h 48m</span>
  </div>
  <div class="mb-4 grid grid-cols-3 gap-2">
    <div class="rounded-md bg-group p-3">
      <div class="font-mono text-xl text-ink">21</div>
      <div class="text-[11px] text-muted2">handled</div>
    </div>
    <div class="rounded-md border border-amberbg2 bg-amberbg p-3">
      <div class="font-mono text-xl text-amber2">2</div>
      <div class="text-[11px] text-amber">woke you</div>
    </div>
    <div class="rounded-md bg-group p-3">
      <div class="font-mono text-xl text-ink">96</div>
      <div class="text-[11px] text-muted2">stayed silent</div>
    </div>
  </div>
  <div class="flex flex-col gap-2 font-mono text-[11.5px]">
    <div class="flex gap-2.5 rounded border-l-2 border-indigo bg-group px-3 py-2 text-ink2">
      <Icon name="tabler:check" class="shrink-0 text-indigo" width="15" height="15" />
      <span><span class="text-muted2">02:14</span> answered — chose strict TypeScript, per your rule</span>
    </div>
    <div class="flex gap-2.5 rounded border-l-2 border-amber bg-amberbg px-3 py-2 text-amber2">
      <Icon name="tabler:alert-triangle" class="shrink-0 text-amber" width="15" height="15" />
      <span><span class="text-amber/70">03:40</span> woke you — DB migration is destructive, needs your call</span>
    </div>
  </div>
</div>
