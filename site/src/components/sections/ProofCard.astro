---
import { Icon } from "astro-icon/components";

// Illustrative, not a mirror of any app widget — it shows the mechanism rather
// than the shipped layout. The evidence column is the point: an item only
// reaches `done` on concrete evidence (exit codes, test output), never on the
// agent's say-so, and the session wraps up only once every item is terminal.
const backlog = [
  { item: "auth suite", evidence: "142 passed · exit 0", done: true },
  { item: "typecheck", evidence: "tsc exit 0 · 0 errors", done: true },
  { item: "changelog entry", evidence: "waiting — no diff yet", done: false },
];
---
<div class="rounded-lg border border-edge bg-panel p-5">
  <div class="mb-3.5 flex items-center justify-between">
    <span class="font-mono text-[11px] text-muted2">macbook-pro · api</span>
    <span class="rounded border border-edge px-2 py-0.5 font-mono text-[10px] text-indigo">watching</span>
  </div>

  <div class="mb-1.5 text-sm font-medium text-ink">Migrate auth to session tokens</div>

  <div class="mb-3.5 flex items-start gap-1.5 font-mono text-[11.5px] leading-relaxed text-ok">
    <Icon name="tabler:check" class="mt-0.5 shrink-0" width="13" height="13" />
    <span>wraps up when every item is done — on evidence, not on say-so</span>
  </div>

  <div class="mb-2.5 flex items-baseline justify-between border-t border-edge-inner pt-3">
    <span class="text-[11px] text-muted2">2 of 3 items done</span>
    <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-faint">evidence</span>
  </div>

  <div class="mb-3.5 flex flex-col gap-1.5 font-mono text-[11.5px]">
    {backlog.map((r) => (
      <div class="flex items-center gap-2">
        <Icon
          name={r.done ? "tabler:check" : "tabler:minus"}
          class={`shrink-0 ${r.done ? "text-ok" : "text-faint"}`}
          width="13"
          height="13"
        />
        <span class="shrink-0 text-ink2">{r.item}</span>
        <span class="flex-1 truncate text-right text-muted2">{r.evidence}</span>
      </div>
    ))}
  </div>

  <div class="flex gap-2.5 rounded border-l-2 border-amber bg-amberbg px-3 py-2 font-mono text-[11.5px] text-amber2">
    <Icon name="tabler:alert-triangle" class="shrink-0 text-amber" width="15" height="15" />
    <span><span class="text-amber/70">03:40</span> woke you — the migration drops a column, needs your call</span>
  </div>
</div>
