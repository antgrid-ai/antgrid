---
import UseCase from "../ui/UseCase.astro";

const steps = [
  { title: "Install on your machine", body: "Download the desktop app for Windows, macOS or Linux. Open a project on that machine." },
  { title: "Start a session", body: "Run your installed coding agent in antgrid's terminal, using your existing agent account and prompts." },
  { title: "Hand over when you're ready", body: "Tell Handler what's left, how to proceed and when to ask you. Arm it, then review its next decision." },
];
---
<section class="mx-auto max-w-shell px-6 py-16 md:py-24">
  <h2 class="mb-10 font-display text-title font-bold text-ink">Start with one session.</h2>

  {/* Numbered because setup genuinely is ordered — you can't run an agent
      through antgrid before installing it. The ordinals are set in the display
      face at ordinal size: the same signage as the headlines, used as a
      graphic, which is what lets the columns stand without boxes. */}
  <ol class="grid gap-y-8 md:grid-cols-3 md:gap-x-10">
    {steps.map((s, i) => (
      <li class="border-t border-edge-emph pt-5">
        <span class="mb-5 block font-display text-ordinal font-bold text-muted2" aria-hidden="true">{i + 1}</span>
        <h3 class="mb-2 text-note font-medium text-ink">{s.title}</h3>
        <p class="text-note leading-relaxed text-muted">{s.body}</p>
      </li>
    ))}
  </ol>

  <UseCase class="mt-10 max-w-2xl">For your first run, research and plan a new feature with your agent. Then ask Handler to guide it through implementation, code review, security review and smoke tests, compacting context between steps.</UseCase>
</section>
