---
import Eyebrow from "../ui/Eyebrow.astro";
import FleetScene from "../shell/FleetScene.astro";
import UseCase from "../ui/UseCase.astro";
---
{/* The band the page is widest at — this is the "one screen" claim, so the
    window gets the full shell and an inset floor to sit on. */}
<section id="fleet" class="reveal border-y border-edge-inner bg-well">
  <div class="mx-auto max-w-shell px-6 py-24">
    <Eyebrow class="mb-5">Fleet view</Eyebrow>
    <h2 class="mb-4 font-display text-title font-semibold text-ink">See which session needs you.</h2>
    <p class="mb-10 max-w-2xl text-lede text-muted">
      See your sessions across machines, with their current status in one view.
    </p>

    <FleetScene />

    <UseCase class="mt-7 max-w-2xl">Several agents running. One needs a decision. Find it without opening every terminal.</UseCase>
  </div>
</section>
