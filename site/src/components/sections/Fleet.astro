---
import FleetScene from "../shell/FleetScene.astro";
import UseCase from "../ui/UseCase.astro";
---
{/* The band the page is widest at — this is the "one screen" claim, so the
    window gets the full shell and an inset floor to sit on. Well, not group:
    a band has to be a step the eye can see, or it is a slab. */}
<section id="fleet" class="border-y border-edge-inner bg-well">
  <div class="mx-auto max-w-shell px-6 py-16 md:py-24">
    <div class="mb-10 grid gap-x-16 gap-y-4 md:grid-cols-2 md:items-end">
      <h2 class="font-display text-title font-bold text-ink">See which session needs you.</h2>
      <p class="text-lede text-muted md:max-w-md">
        Every session on every machine, with its current status, in one list.
      </p>
    </div>

    <FleetScene />

    <UseCase class="mt-8 max-w-2xl">Several agents running. One needs a decision. Find it without opening every terminal.</UseCase>
  </div>
</section>
