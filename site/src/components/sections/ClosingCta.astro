---
import { Icon } from "astro-icon/components";
import Eyebrow from "../ui/Eyebrow.astro";
import Button from "../ui/Button.astro";
import { links, PLATFORMS, downloadUrlFor } from "../../config";
import { BETA_FREE, FREE_WORKERS } from "../../data/pricing";

// The same OS-matched button the hero leads with, through the same /download —
// a closing CTA that ends on a doc link is a page that never asks for the thing
// it spent nine sections arguing for. The setup guide keeps its place in the
// line below, which is where a reader who wants to read first looks anyway.
---
<section id="download" class="reveal mx-auto max-w-shell px-6 py-20">
  <div class="card-lit relative overflow-hidden rounded-xl border border-signaldeep2 bg-[#17171e] px-9 py-14 text-center">
    <div class="pointer-events-none absolute -top-48 left-1/2 h-105 w-160 -translate-x-1/2 glow-signal" aria-hidden="true"></div>
    <div class="relative">
    <Eyebrow class="mb-5 justify-center">Get started</Eyebrow>
    <h2 class="mb-5 font-display text-title font-semibold text-ink">
      Try one workflow.<br />Watch the handoff.
    </h2>
    <p class="mx-auto mb-8 max-w-md text-lede text-muted">
      {BETA_FREE ? (
        <><span class="text-ink2">Free during beta, with Handler included.</span> Use your existing repo and agent account.</>
      ) : (
        <>Start with remote control, free on {FREE_WORKERS} machine. Handler is included with Pro. <a href={links.pricing} class="text-signal2 hover:text-signal">See plans and trial details</a>.</>
      )}
    </p>
    <div class="mb-3.5 flex flex-wrap items-center justify-center gap-3">
      {PLATFORMS.map((p) => (
        <Button href={downloadUrlFor(p.id)} variant="primary" class={`dl-os dl-${p.os}`}>
          <Icon name={p.icon} width="16" height="16" />Download for {p.name}
        </Button>
      ))}
    </div>
    <p class="mb-2 text-meta text-muted2">{BETA_FREE ? "No card required. Your agent provider's usage charges or limits still apply." : "Remote control is included on the free plan."}</p>
    {/* The escape hatch for the OS match: this band is where a reader on the
        wrong machine — or downloading for one they are not sitting at — has to
        be able to name their own build. Each goes through /download like every
        other download on the site, so a build the reader's machine cannot run is
        offered there rather than fired; the raw artifacts stay one layer down,
        in the guide. */}
    {/* Its own line rather than trailing the build list: the same middot cannot
        separate three peers AND then a different sentence — run together, "Linux ·
        First time?" reads as a fourth build for one beat, and the whole thing
        clumps into three wrapped lines on a phone. */}
    <p class="mb-1.5 text-meta text-muted2">
      All builds: {PLATFORMS.map((p, i) => (
        <>{i > 0 && <span class="text-faint"> · </span>}<a href={downloadUrlFor(p.id)} class="text-signal2 hover:text-signal">{p.name}</a></>
      ))}
    </p>
    <p class="mb-8 text-meta text-muted2">
      First time? Follow the <a href={links.getStarted} class="text-signal2 hover:text-signal">setup guide</a> to start a session.
    </p>

    {/* A sentence, not two dead store chips. Invites are open today — a page that
        closes on "App Store — soon" tells a reader the phone half is unavailable,
        which is both wrong and the half the product is for. */}
    <p class="text-meta text-muted2">
      Phone access is by invite during beta. <a href={links.mobileInvite} class="text-signal2 hover:text-signal">Request iOS or Android access</a>.
    </p>
    </div>
  </div>
</section>
