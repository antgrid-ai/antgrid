---
import { Icon } from "astro-icon/components";

const agents = [
  { name: "Claude Code", icon: "claudecode", color: "#D97757", w: 22 },
  { name: "Codex", icon: "simple-icons:openai" },
  { name: "opencode", icon: "simple-icons:opencode" },
  { name: "Cursor", icon: "simple-icons:cursor" },
  { name: "GitHub Copilot", icon: "simple-icons:githubcopilot" },
  { name: "Antigravity", icon: "antigravity-color" },
  { name: "Kilo", icon: "kilocode" },
  { name: "Kimi", icon: "simple-icons:kimi" },
  { name: "Mistral Vibe", icon: "mistralai", color: "#FA520F", w: 20 },
];
---
{/* A caption under the hero window, not a band of its own: the roster answers
    "does it run mine?" and nothing else, and a ruled section for a yes/no
    reads as a feature the page is trying to sell. One rule, one row. */}
<section id="agents" class="mx-auto max-w-shell px-6 pb-16 md:pb-20">
  <div class="flex flex-wrap items-center gap-x-5 gap-y-3 border-t border-edge-inner pt-6">
    <span class="mr-1 text-note text-muted2">Works with</span>
    {agents.map((a) => (
      <span class="inline-flex items-center gap-2 text-note text-ink2">
        {/* w overrides the default square slot for marks whose real aspect
            ratio is landscape (Claude Code, Mistral) — forcing those into
            15x15 just letterboxes them small again. */}
        <Icon name={a.icon} class="shrink-0" width={a.w ?? 15} height="15" style={a.color ? `color:${a.color}` : undefined} />
        {a.name}
      </span>
    ))}
  </div>
  {/* Its own line, on purpose: trailing the roster it wrapped alone at most
      widths and read as a tenth agent nobody had heard of. */}
  <p class="mt-3 text-meta text-muted2">Any other agent that runs in a terminal works too.</p>
</section>
