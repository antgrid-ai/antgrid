---
import UseCase from "../ui/UseCase.astro";

const steps = [
  "Install antgrid on your machine and phone",
  "Sign in to the same account on both",
  "Enable remote access on the machine",
];
---
{/* Reach, Worktrees and Messaging are one chapter in three entries: the same
    two columns, text left and record right, every time. Alternating the sides
    would make three sections out of them; holding the line makes a list. This
    one opens the chapter, so it carries no rule of its own — the Fleet band
    above already closes on one. */}
<section id="reach" class="mx-auto max-w-shell px-6 pt-16 md:pt-24">
  <div class="grid gap-x-16 gap-y-10 md:grid-cols-2">
    <div>
      <h2 class="mb-6 font-display text-title font-bold text-ink">Run agents where your code already is.</h2>
      <p class="mb-6 max-w-xl text-lede text-muted">
        Your agent runs on your machine, with your existing repo, local database and development tools. Connect through antgrid without setting up a VPN or port forwarding.
      </p>
      <UseCase class="max-w-xl">Away from your desk? Check the session running on your workstation and reply from your phone.</UseCase>
    </div>

    <div>
      <p class="mb-3 text-note text-muted2">Connect from your phone</p>
      {/* Numbered because it is a sequence: the account has to exist on both
          devices before the switch on one of them means anything. */}
      <ol class="ledger">
        {steps.map((step, i) => (
          <li class="flex items-baseline gap-5 py-3.5 text-note text-ink2">
            <span class="w-6 shrink-0 font-display text-kicker font-bold text-muted2">{i + 1}</span>
            <span>{step}</span>
          </li>
        ))}
      </ol>
      <p class="mt-4 text-meta leading-relaxed text-muted2">Both devices connect out to the relay. No inbound port required.</p>
    </div>
  </div>
</section>
