---
import { Icon } from "astro-icon/components";
import Eyebrow from "../ui/Eyebrow.astro";
import Readout from "../ui/Readout.astro";
import UseCase from "../ui/UseCase.astro";

const steps = [
  "Install antgrid on your machine and phone",
  "Sign in to the same account on both",
  "Enable remote access on the machine",
];
---
<section id="reach" class="reveal mx-auto max-w-shell px-6 py-24">
  <div class="grid items-center gap-12 md:grid-cols-2">
    <div>
      <Eyebrow class="mb-5">Your machines</Eyebrow>
      <h2 class="mb-5 font-display text-title font-semibold text-ink">Run agents where your code already is.</h2>
      <p class="mb-6 max-w-xl text-lede text-muted">
        Your agent runs on your machine, with your existing repo, local database and development tools. Connect through antgrid without setting up a VPN or port forwarding.
      </p>

      <UseCase class="max-w-xl">Away from your desk? Check the session running on your workstation and reply from your phone.</UseCase>
    </div>

    <Readout source="Connect from your phone" state="connected" class="min-w-0">
      <ol class="flex flex-col gap-4 p-4 md:p-5">
        {steps.map((step, i) => (
          <li class="flex items-start gap-3 text-note leading-relaxed text-ink2">
            <span class="font-mono text-signal2">0{i + 1}</span>
            <span>{step}</span>
          </li>
        ))}
      </ol>

      <Fragment slot="foot">
        <span class="flex items-start gap-2">
          <Icon name="tabler:arrows-left-right" class="mt-0.5 shrink-0 text-faint" width="13" height="13" />
          <span>Both devices connect out to the relay. No inbound port required.</span>
        </span>
      </Fragment>
    </Readout>
  </div>
</section>
