---
import { Icon } from "astro-icon/components";
import Eyebrow from "../ui/Eyebrow.astro";
import Chip from "../ui/Chip.astro";

// Framed as safety for Handler autonomy, never as parallelism-at-scale — the
// "N agents in parallel" axis is a competitor's headline and first-party table
// stakes. The claim here is the blast radius: worktree = scope, evidence gate
// = contract, main tree = untouched.
const sessions = [
  { branch: "auth-tokens", agent: "Claude Code", note: "running — 2 of 3 proven", state: "working" },
  { branch: "checkout-tests", agent: "Codex", note: "done on evidence — review the branch", state: "done" },
];
---
<section id="isolation" class="reveal mx-auto max-w-shell px-6 py-20">
  <div class="grid items-center gap-12 md:grid-cols-2">
    <div>
      <Eyebrow class="mb-4">Isolated sessions</Eyebrow>
      <h2 class="mb-3.5 text-3xl font-medium tracking-tight text-ink">Let it run. Your tree doesn't move.</h2>
      <p class="mb-3.5 max-w-xl text-base leading-relaxed text-muted">
        Start a session isolated and antgrid provisions a managed git worktree for it — its own checkout, its own branch. Everything you see from your phone follows that checkout: files, diffs, terminal, preview. Handler's judge reads its evidence from the same tree.
      </p>
      <p class="mb-5 max-w-xl text-base leading-relaxed text-muted">
        An agent is only safe to walk away from when its blast radius is a branch. When the work proves out, review and merge it. When it doesn't, throw the worktree away — <span class="text-ink2">main never knew</span>.
      </p>
      <div class="flex flex-wrap gap-2">
        <Chip>own checkout, own branch</Chip>
        <Chip>your view follows the worktree</Chip>
        <Chip>main stays clean</Chip>
      </div>
    </div>

    <div class="card-lit rounded-lg border border-edge bg-panel p-5">
      <div class="mb-3.5 flex items-center justify-between">
        <span class="font-mono text-[11px] text-muted2">~/repos/api</span>
        <span class="flex items-center gap-1.5 rounded border border-edge px-2 py-0.5 font-mono text-[10px] text-ok">
          <Icon name="tabler:git-branch" width="11" height="11" />main · clean
        </span>
      </div>

      <div class="flex flex-col gap-1.5">
        {sessions.map((s) => (
          <div class="flex items-center gap-2.5 rounded border border-edge-inner bg-chrome px-3 py-2.5 font-mono text-[11.5px]">
            {s.state === "done"
              ? <Icon name="tabler:circle-check" class="shrink-0 text-ok" width="14" height="14" />
              : <span class="size-2 shrink-0 rounded-full bg-indigo animate-pulse-dot"></span>}
            <Icon name="tabler:git-branch" class="shrink-0 text-muted2" width="13" height="13" />
            <span class="shrink-0 text-ink2">{s.branch}</span>
            <span class="rounded border border-edge px-1.5 py-0.5 text-[10px] text-muted2">{s.agent}</span>
            <span class={`flex-1 truncate text-right ${s.state === "done" ? "text-ok" : "text-muted2"}`}>{s.note}</span>
          </div>
        ))}
      </div>

      <div class="mt-3.5 flex items-center gap-2 border-t border-edge-inner pt-3 font-mono text-[11px] text-muted2">
        <Icon name="tabler:folder" class="text-faint" width="13" height="13" />
        <span>working tree untouched — <span class="text-ink2">0 files changed</span> on main</span>
      </div>
    </div>
  </div>
</section>
