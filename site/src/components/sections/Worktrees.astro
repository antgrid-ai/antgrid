---
import { Icon } from "astro-icon/components";
import UseCase from "../ui/UseCase.astro";

// A separate checkout separates edits; it is not an execution sandbox.
const sessions = [
  { branch: "auth-tokens", agent: "Claude Code", note: "running in its own checkout", state: "working" },
  { branch: "checkout-tests", agent: "Codex", note: "ready for your review", state: "done" },
];
---
<section id="isolation" class="mx-auto max-w-shell px-6 pt-14 md:pt-16">
  <div class="grid gap-x-16 gap-y-10 border-t border-edge pt-14 md:grid-cols-2 md:pt-16">
    <div>
      <h2 class="mb-6 font-display text-title font-bold text-ink">Give the session its own branch.</h2>
      <p class="mb-6 max-w-xl text-lede text-muted">
        Start an isolated session in a Git repository. antgrid creates a separate checkout and branch for it. The session's files, diffs, terminal and preview follow that checkout, so you can review its changes before merging.
      </p>
      <UseCase class="max-w-xl">Let an agent work on a fix while you keep working in your own checkout.</UseCase>
    </div>

    <div>
      <p class="mb-3 text-note text-muted2">Two isolated sessions, illustrated</p>
      <ul class="ledger">
        {sessions.map((s) => (
          <li class="flex flex-wrap items-center gap-x-3 gap-y-1 py-3.5">
            {s.state === "done"
              ? <Icon name="tabler:circle-check" class="shrink-0 text-ok" width="15" height="15" />
              : <span class="mx-0.5 size-2 shrink-0 rounded-full bg-signal animate-pulse-dot"></span>}
            <span class="inline-flex items-center gap-1.5 font-mono text-row text-ink2">
              <Icon name="tabler:git-branch" class="shrink-0 text-muted2" width="13" height="13" />{s.branch}
            </span>
            <span class="text-meta text-muted2">{s.agent}</span>
            <span class={`ml-auto text-meta ${s.state === "done" ? "text-ok" : "text-muted2"}`}>{s.note}</span>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-meta leading-relaxed text-muted2">Separate working files. <span class="text-ink2">Not a sandbox.</span></p>
    </div>
  </div>
</section>
