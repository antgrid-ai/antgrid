---
import { Icon } from "astro-icon/components";
import Eyebrow from "../ui/Eyebrow.astro";
import { links } from "../../config";
import Readout from "../ui/Readout.astro";

const cipher = ["k7Vd2+Rm9pQ1fX0aZ", "hN8wYc4Lbe6Tj/Ou2", "gP5sKi0nDqWx3Hr+M", "zA9vCt7Bf1Ul6Ey4o", "Js2Rn8Xa0Pd5Mk3Iq", "4Wb7Lz1Tv9Co6Ge+H"];
---
<section class="reveal border-y border-edge-inner bg-well">
  <div class="mx-auto max-w-shell px-6 py-16 md:py-20">
  <Eyebrow class="mb-5">End-to-end encrypted</Eyebrow>
  <h2 class="mb-5 font-display text-title font-semibold text-ink">The relay can't read your session.</h2>
  <p class="mb-10 max-w-xl text-lede text-muted">
    Terminal output, prompts and file contents are encrypted between your machine and your connected devices. The relay forwards that encrypted content without the keys to decrypt it.
  </p>

  <p class="mb-4 text-meta text-muted2">Illustrative session content and encrypted relay traffic</p>
  <div class="mb-7 grid items-stretch gap-0 md:grid-cols-[1fr_44px_1fr]">
    <Readout source="What you see" state="readable" label="decrypted">
      <pre class="overflow-x-auto p-3.5 font-mono text-row text-ink2"><span class="text-faint">studio-workstation · </span><span class="text-signal">Claude Code</span>
<span class="text-muted2">02:14</span>  Editing <span class="text-signal2">auth/session.ts</span>
       <span class="text-ok">+</span> verifyPairApproval(sig, uuid)
<span class="text-ok">✓</span> 142 files typechecked
<span class="text-amber">?</span> approve destructive migration?</pre>
    </Readout>

    <div class="flex items-center justify-center py-2">
      <div class="flex size-8 items-center justify-center rounded-full border border-signaldeep2 bg-signaldeep">
        <Icon name="tabler:arrow-right" class="text-signal2" width="15" height="15" />
      </div>
    </div>

    <Readout source="What the relay sees" state="sealed" label="ciphertext" tone="well">
      <pre class="relative max-h-40 overflow-hidden break-all p-3.5 font-mono text-row text-edge-emph"><span class="cipher-scroll block">{cipher.join("\n") + "\n" + cipher.join("\n") + "\n"}</span></pre>
    </Readout>
  </div>

  <a href={links.security} class="inline-flex items-center gap-2 text-note font-medium text-signal2 hover:text-signal">How encryption works <span aria-hidden="true">→</span></a>
  </div>
</section>
