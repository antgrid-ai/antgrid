---
import { Icon } from "astro-icon/components";
import { links } from "../../config";

const cipher = ["k7Vd2+Rm9pQ1fX0aZ", "hN8wYc4Lbe6Tj/Ou2", "gP5sKi0nDqWx3Hr+M", "zA9vCt7Bf1Ul6Ey4o", "Js2Rn8Xa0Pd5Mk3Iq", "4Wb7Lz1Tv9Co6Ge+H"];
---
<section class="border-y border-edge-inner bg-well">
  <div class="mx-auto max-w-shell px-6 py-16 md:py-24">
    <div class="mb-10 grid gap-x-16 gap-y-4 md:grid-cols-2 md:items-end">
      <h2 class="font-display text-title font-bold text-ink">The relay can't read your session.</h2>
      <p class="text-lede text-muted md:max-w-md">
        Terminal output, prompts and file contents are encrypted between your machine and your connected devices. The relay forwards them without the keys to read them.
      </p>
    </div>

    {/* Two records side by side on the same rule, and the arrow between them
        is the whole diagram: the left one goes in, the right one comes out. */}
    <div class="grid items-start gap-8 md:grid-cols-[minmax(0,1fr)_2.5rem_minmax(0,1fr)] md:gap-5">
      <div>
        <div class="flex items-baseline justify-between gap-3 border-t border-edge-emph pt-3">
          <span class="text-note text-ink2">What you see</span>
          <span class="inline-flex items-center gap-1.5 text-meta text-ok"><Icon name="tabler:eye" width="12" height="12" />decrypted</span>
        </div>
        <pre class="mt-3 overflow-x-auto font-mono text-row text-ink2"><span class="text-faint">studio-workstation · </span><span class="text-signal">Claude Code</span>
<span class="text-muted2">02:14</span>  Editing <span class="text-signal2">auth/session.ts</span>
       <span class="text-ok">+</span> verifyPairApproval(sig, uuid)
<span class="text-ok">✓</span> 142 files typechecked
<span class="text-amber">?</span> approve destructive migration?</pre>
      </div>

      <div class="hidden justify-center pt-12 md:flex" aria-hidden="true">
        <Icon name="tabler:arrow-right" class="text-signal" width="20" height="20" />
      </div>

      <div>
        <div class="flex items-baseline justify-between gap-3 border-t border-edge-emph pt-3">
          <span class="text-note text-ink2">What the relay sees</span>
          <span class="inline-flex items-center gap-1.5 text-meta text-muted2"><Icon name="tabler:lock" width="12" height="12" />ciphertext</span>
        </div>
        <pre class="relative mt-3 max-h-32 overflow-hidden break-all font-mono text-row text-faint"><span class="cipher-scroll block">{cipher.join("\n") + "\n" + cipher.join("\n") + "\n"}</span></pre>
      </div>
    </div>

    <a href={links.security} class="mt-10 inline-block text-note font-medium text-signal2 underline decoration-signaldeep2 underline-offset-4 hover:text-signal hover:decoration-signal">How encryption works</a>
  </div>
</section>
