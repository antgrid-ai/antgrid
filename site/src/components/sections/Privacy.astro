---
import { Icon } from "astro-icon/components";
import Eyebrow from "../ui/Eyebrow.astro";
import Chip from "../ui/Chip.astro";
import Readout from "../ui/Readout.astro";

const cipher = ["k7Vd2+Rm9pQ1fX0aZ", "hN8wYc4Lbe6Tj/Ou2", "gP5sKi0nDqWx3Hr+M", "zA9vCt7Bf1Ul6Ey4o", "Js2Rn8Xa0Pd5Mk3Iq", "4Wb7Lz1Tv9Co6Ge+H"];
---
<section class="reveal border-y border-edge-inner bg-well">
  <div class="mx-auto max-w-shell px-6 py-24">
  <Eyebrow class="mb-5">End-to-end encrypted</Eyebrow>
  <h2 class="mb-5 font-display text-title font-semibold text-ink">The relay can't read a byte.</h2>
  <p class="mb-3 max-w-xl text-lede text-muted">
    Everything you just saw — terminal output, your prompts, the files, every approval — is sealed on your machine and only opens on your phone. The server in the middle just forwards blobs it can never decrypt.
  </p>
  <p class="mb-10 max-w-xl text-note text-muted2">
    The alternative is letting someone else's machine hold your code. <span class="text-ink2">antgrid runs the agent on yours</span> — and the relay in between is built so it can't read what passes through.
  </p>

  {/* The same stream, twice: the pane on the right is what the wire carries. */}
  <div class="mb-7 grid items-stretch gap-0 md:grid-cols-[1fr_44px_1fr]">
    <Readout source="What you see" state="readable" label="decrypted">
      <pre class="overflow-x-auto p-3.5 font-mono text-row text-ink2"><span class="text-faint">studio-workstation · </span><span class="text-signal">Claude Code</span>
<span class="text-muted2">02:14</span>  Editing <span class="text-signal2">auth/session.ts</span>
       <span class="text-ok">+</span> verifyPairApproval(sig, uuid)
<span class="text-ok">✓</span> 142 files typechecked
<span class="text-amber">?</span> approve destructive migration?</pre>
    </Readout>

    <div class="flex items-center justify-center py-2">
      <div class="flex size-8 items-center justify-center rounded-full border border-signaldeep2 bg-signaldeep">
        <Icon name="tabler:arrow-right" class="text-signal2" width="15" height="15" />
      </div>
    </div>

    <Readout source="What the relay sees" state="sealed" label="ciphertext" tone="well">
      <pre class="relative max-h-40 overflow-hidden break-all p-3.5 font-mono text-row text-edge-emph"><span class="cipher-scroll block">{cipher.join("\n") + "\n" + cipher.join("\n") + "\n"}</span></pre>
    </Readout>
  </div>

  <div class="flex flex-wrap gap-2">
    <Chip><Icon name="tabler:key" class="text-signal" width="13" height="13" />X25519 key exchange</Chip>
    <Chip><Icon name="tabler:shield-lock" class="text-signal" width="13" height="13" />AES-256-GCM</Chip>
    <Chip><Icon name="tabler:device-mobile" class="text-signal" width="13" height="13" />keys never leave your devices</Chip>
    <Chip><Icon name="tabler:database-off" class="text-signal" width="13" height="13" />nothing readable stored</Chip>
  </div>
  </div>
</section>
