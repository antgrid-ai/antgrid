---
import { Icon } from "astro-icon/components";
import { links } from "../config";
import Mark from "./ui/Mark.astro";
import Wordmark from "./ui/Wordmark.astro";
---
<footer class="border-t border-edge-inner">
  <div class="mx-auto max-w-shell px-6 pb-8 pt-12">
    <div class="grid grid-cols-2 gap-8 lg:grid-cols-[1.7fr_1fr_1fr_1fr]">
      <div>
        {/* The full lockup, as in the nav — the wordmark alone was the only
            place on the site the mark was dropped, so the page opened and closed
            on two different marques. h-8 against the wordmark's h-6 holds the
            kit's proportion (the mark box runs 4/3 of the type size); scaled
            down from the nav's 9/7 because the footer is a sign-off, not a
            header. Keep the pair in step. */}
        <div class="mb-2.5 flex items-center gap-2">
          <Mark class="h-8 w-auto" />
          <Wordmark class="h-6 w-auto" />
        </div>
        <p class="mb-3.5 max-w-57.5 text-meta leading-relaxed text-muted">
          Your agents and machines in one place. Hand over the follow-ups on long-running tasks to Handler.
        </p>
        <span class="inline-flex items-center gap-1.5 rounded border border-edge px-2.5 py-1 font-mono text-marker text-muted2">
          <Icon name="tabler:lock" class="text-signal" width="12" height="12" />end-to-end encrypted · zero-knowledge relay
        </span>
      </div>
      <div>
        <p class="mb-3 text-meta text-muted2">Product</p>
        <div class="flex flex-col gap-2.5 text-note text-muted">
          <a href={links.features} class="hover:text-ink">Features</a>
          <a href={links.pricing} class="hover:text-ink">Pricing</a>
          <a href={links.download} class="hover:text-ink">Download</a>
          <a href={links.getStarted} class="hover:text-ink">Get started</a>
          <a href={links.support} class="hover:text-ink">Support</a>
          <a href={links.security} class="hover:text-ink">Security</a>
          <a href={links.changelog} class="hover:text-ink">Changelog</a>
          <a href={links.blog} class="hover:text-ink">Blog</a>
        </div>
      </div>
      <div>
        <p class="mb-3 text-meta text-muted2">Account</p>
        <div class="flex flex-col gap-2.5 text-note text-muted">
          <a href={links.signIn} class="hover:text-ink">Sign in</a>
        </div>
      </div>
      <div>
        <p class="mb-3 text-meta text-muted2">Legal</p>
        <div class="flex flex-col gap-2.5 text-note text-muted">
          <a href={links.privacy} class="hover:text-ink">Privacy</a>
          <a href={links.terms} class="hover:text-ink">Terms</a>
          <a href={links.license} class="hover:text-ink">MPL-2.0 licence</a>
          <a href={links.refunds} class="hover:text-ink">Refunds</a>
        </div>
      </div>
    </div>
    <div class="mt-7 flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-edge-inner pt-4.5 font-mono text-marker text-faint">
      <span>© 2026 antgrid</span>
      <span aria-hidden="true">·</span>
      {/* The repo, with no ask attached. /security already sends readers here to
          check the handshake spec against the client that implements it, so the
          link exists on the site either way — it just had nowhere a reader could
          find it without being sold something first. The star ask lives on
          /download, the one page where a reader already has what they came
          for. */}
      <a href={links.repo} class="inline-flex items-center gap-1.5 text-muted hover:text-ink">
        <Icon name="tabler:brand-github" width="13" height="13" />GitHub
      </a>
      <span aria-hidden="true">·</span>
      <a href={links.exactSource} class="text-muted hover:text-ink">Exact source</a>
      <span aria-hidden="true">·</span>
      <a href={links.company} class="group inline-flex items-center gap-1.5 text-muted hover:text-ink">
        <span>a product of</span>
        <img src="/logo/radhaai-mark.svg" alt="" width="13" height="13" class="rounded-[2px]" />
        <span class="group-hover:text-ink">Radha AI Products</span>
      </a>
      {/* The colour-scheme override, and the only place on the site it lives.
          The page follows the OS by itself, so this is a preference control
          rather than a feature, and it sits with the other small print. Hidden
          until JS has run (global.css keys it on html.js) because without the
          script it is three buttons that do nothing. `aria-pressed` is the
          state; the pressed style hangs off it so the two cannot disagree. */}
      <div role="group" aria-label="Colour scheme" data-theme-toggle class="ml-auto overflow-hidden rounded border border-edge">
        {([["system", "System"], ["light", "Light"], ["dark", "Dark"]] as const).map(([choice, label]) => (
          <button
            type="button"
            data-theme-choice={choice}
            aria-pressed={choice === "system" ? "true" : "false"}
            class="px-2 py-1 text-muted transition-colors hover:text-ink aria-pressed:bg-chrome aria-pressed:text-ink motion-reduce:transition-none"
          >{label}</button>
        ))}
      </div>
    </div>
  </div>
</footer>
<script>
  import { mountThemeToggle } from "../scripts/theme";
  mountThemeToggle();
</script>
