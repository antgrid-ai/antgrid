---
import { SALESIQ_WIDGET_URL } from "../config";

const parsed = URL.canParse(SALESIQ_WIDGET_URL) ? new URL(SALESIQ_WIDGET_URL) : null;
const widgetUrl = parsed?.protocol === "https:" ? parsed.toString() : "";
---

<aside class="support-chat" data-salesiq-support data-widget-url={widgetUrl} aria-label="Support">
  <span class="support-chat__status" data-salesiq-status role="status" aria-live="polite"></span>
  <button
    class="support-chat__launcher"
    type="button"
    data-salesiq-open
    aria-label="Chat with support"
    aria-expanded="false"
    title="Chat with support"
  >
    <svg class="support-chat__icon support-chat__icon--chat" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M5.75 4.75h12.5a2.5 2.5 0 0 1 2.5 2.5v7.5a2.5 2.5 0 0 1-2.5 2.5h-6.1L7.5 20.5v-3.25H5.75a2.5 2.5 0 0 1-2.5-2.5v-7.5a2.5 2.5 0 0 1 2.5-2.5Z" />
      <path d="m7.5 9 2 2-2 2M12 13h4.5" />
    </svg>
    <svg class="support-chat__icon support-chat__icon--close" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="m6.75 6.75 10.5 10.5M17.25 6.75 6.75 17.25" />
    </svg>
  </button>
</aside>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-salesiq-support]");
    const button = root?.querySelector("[data-salesiq-open]");
    const status = root?.querySelector("[data-salesiq-status]");
    if (!(root instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;

    const widgetUrl = root.dataset.widgetUrl || "";
    const appHandoff = new URLSearchParams(window.location.hash.slice(1));
    const fromApp = new URLSearchParams(window.location.search).get("source") === "app";
    const visitorName = fromApp ? appHandoff.get("name")?.trim().slice(0, 200) : "";
    const visitorEmail = fromApp ? appHandoff.get("email")?.trim().slice(0, 320) : "";
    if (fromApp && window.location.hash) {
      history.replaceState(null, "", `${window.location.pathname}${window.location.search}`);
    }
    const identify = () => {
      if (visitorName) window.$zoho?.salesiq?.visitor?.name(visitorName);
      if (visitorEmail) window.$zoho?.salesiq?.visitor?.email(visitorEmail);
    };
    // Zoho owns the open/closed state — it can close the window from inside the
    // iframe — so read it off the widget rather than tracking a local boolean.
    const chatIsOpen = () => !!document.querySelector("#zsiq_chat_wrap.chat-iframe-open");
    const setExpanded = (open) => button.setAttribute("aria-expanded", String(open));
    let loading;
    const toggle = () => {
      if (!widgetUrl) {
        window.location.href = "mailto:contact@radhaai.com?subject=Antgrid%20support";
        return;
      }
      if (window.$zoho?.salesiq?.chatwindow) {
        const open = !chatIsOpen();
        if (open) identify();
        window.$zoho.salesiq.chatwindow.visible(open ? "show" : "hide");
        setExpanded(open);
        return;
      }
      if (loading) return;
      button.disabled = true;
      if (status) status.textContent = "Opening support chat…";
      window.$zoho = window.$zoho || {};
      window.$zoho.salesiq = window.$zoho.salesiq || {
        widgetcode: "siqwidget",
        values: {},
        ready: function () {},
      };
      window.$zoho.salesiq.ready = function () {
        window.$zoho.salesiq.tracking?.off();
        window.$zoho.salesiq.floatbutton?.visible("hide");
        identify();
        window.$zoho.salesiq.chatwindow?.visible("show");
        setExpanded(true);
        button.disabled = false;
        if (status) status.textContent = "";
      };
      const script = document.createElement("script");
      script.id = "zsiqscript";
      script.src = widgetUrl;
      script.defer = true;
      loading = new Promise((resolve, reject) => {
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      }).catch(() => {
        script.remove();
        loading = undefined;
        button.disabled = false;
        if (status) status.textContent = "Chat could not load. Email contact@radhaai.com.";
      });
    };
    button.addEventListener("click", toggle);
    if (new URLSearchParams(window.location.search).get("chat") === "1" && widgetUrl) toggle();
  })();
</script>

<style>
  /* Zoho re-shows its own float button as a close ✕ every time the chat window
     opens — on top of the launcher below, which sits in the same corner. The
     `floatbutton.visible("hide")` call above only wins until then, so keep it
     hidden here and let the launcher be the single open/close control. That
     works because Zoho stops the open window just short of this corner, so the
     launcher stays clickable; moving it inboard would bury it under the window.
     Where the window instead goes fullscreen and covers the launcher, Zoho
     draws its own ✕ inside the iframe, so nothing traps the visitor. */
  :global(#zsiq_float) {
    display: none !important;
  }
  .support-chat {
    position: fixed;
    z-index: 60;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }
  .support-chat__launcher {
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    place-items: center;
    border: 1px solid var(--color-signal2);
    border-radius: 0.75rem;
    padding: 0;
    background: var(--color-signalbtn);
    color: var(--color-page);
    cursor: pointer;
    box-shadow: 0 14px 36px -12px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.18);
    transition: transform 150ms ease, background-color 150ms ease, box-shadow 150ms ease;
  }
  .support-chat__launcher:hover {
    transform: translateY(-2px);
    background: var(--color-signal);
    box-shadow: 0 18px 42px -12px rgba(0, 0, 0, 0.9), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }
  .support-chat__icon {
    grid-area: 1 / 1;
    width: 1.65rem;
    height: 1.65rem;
    stroke: currentColor;
    stroke-width: 1.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .support-chat__icon--close { display: none; }
  :global(body:has(#zsiq_chat_wrap.chat-iframe-open)) .support-chat__icon--chat { display: none; }
  :global(body:has(#zsiq_chat_wrap.chat-iframe-open)) .support-chat__icon--close { display: block; }
  .support-chat__launcher:disabled { cursor: wait; opacity: 0.65; transform: none; }
  .support-chat__status {
    max-width: min(20rem, calc(100vw - 2rem));
    border: 1px solid var(--color-edge);
    border-radius: 0.375rem;
    padding: 0.45rem 0.65rem;
    background: var(--color-panel);
    color: var(--color-ink2);
    box-shadow: 0 10px 28px -12px rgba(0, 0, 0, 0.8);
    font-size: 0.75rem;
  }
  .support-chat__status:empty { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .support-chat__launcher { transition: none; }
    .support-chat__launcher:hover { transform: none; }
  }
</style>
