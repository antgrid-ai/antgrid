---
// The consequence line under a section's argument: what the mechanism above
// actually buys the reader, in one sentence, second person. One per section, so
// every band answers "and therefore?" instead of leaving the reader to infer it.
//
// The marker is one filled grid cell — the hero's own vocabulary, a machine
// that is working — and it carries the accent so the sentence can stay ink.
// Sans, not mono: this is still argument, and mono on this site is reserved
// for what a machine produced.
const { class: cls = "" } = Astro.props;
---
<p class={`flex gap-3 text-note leading-relaxed text-ink2 ${cls}`}>
  <span class="mt-[0.55em] size-2 shrink-0 bg-signal" aria-hidden="true"></span>
  <span><slot /></span>
</p>
