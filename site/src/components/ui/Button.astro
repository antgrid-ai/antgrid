---
interface Props { href: string; variant?: "primary" | "outline"; class?: string }
const { href, variant = "primary", class: cls = "" } = Astro.props;
const base =
  "inline-flex items-center gap-2 rounded-md px-6 py-3 text-sm font-medium transition-colors";
const styles =
  variant === "primary"
    ? "bg-indigobtn text-white hover:bg-indigo"
    : "border border-edge-emph text-ink2 hover:bg-panel";
---
<a href={href} class={`${base} ${styles} ${cls}`}><slot /></a>
