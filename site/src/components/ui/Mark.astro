---
// The four-agent mark, inheriting `currentColor`. NOT antgrid-mark-transparent
// .svg, which carries the same art: that one adapts through
// `prefers-color-scheme`, which keys off the reader's OS rather than the page,
// and this site forces dark — an inlined copy would flip the wrong way for a
// light-OS visitor.
//
// Imported out of public/ for the same reason as Wordmark.astro — the file the
// nav renders and the file the brand URL hands out stay the same bytes — and
// inlined rather than <img> so it arrives with the first frame instead of
// costing a second round trip that the nav has no reserved width for.
import Mark from "../../../public/logo/antgrid-mark-full.svg";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
{/* aria-hidden: the wordmark beside it already names the link, and the file
    carries role="img" aria-label="Antgrid" for standalone use — left as-is the
    home link announces "Antgrid Antgrid". */}
<Mark class={className} aria-hidden="true" />
