---
import "../styles/global.css";
import { Font } from "astro:assets";
import Seo from "../components/Seo.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  path?: string;
  robots?: string;
}
const { title, description, ogImage, ogImageAlt, path, robots } = Astro.props;
---
<html lang="en">
  <head>
    {/* preload on all three because all three are in the first viewport: Archivo
        in the headline, Inter in the lede and nav, mono in the eyebrow, beta pill
        and ProofCard. Without it a font is not even requested until the
        render-blocking CSS has parsed — HTML, then CSS, then woff2, three serial
        round trips — which is why the swap used to land long after the page
        looked finished. <Font> emits the @font-face, the metric-matched fallback
        and the correctly-formed preload link together, so these stay in step. */}
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains" preload />
    <Seo title={title} description={description} ogImage={ogImage} ogImageAlt={ogImageAlt} path={path} robots={robots} />
    {/* Two things follow the reader's own OS off this one attribute: the
        mockup's window chrome, because the app's does (Windows paints its own
        caption buttons, macOS keeps the real NSWindow traffic lights —
        app/lib/window/window_capabilities.dart), and the hero's download
        button, which offers the build the reader can actually install.
        `is:inline` is load-bearing — Astro would otherwise bundle this as a
        deferred module and both swaps would land a frame after paint, as a
        visible flicker in the hero. Windows is the no-JS default, so a bot, an
        OG screenshot or a blocked script still gets a coherent window and a
        working CTA rather than a bare one and none. */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        // High-entropy client hints need an async request, so the low-entropy
        // `platform` plus the UA string is the whole budget here. Order matters,
        // not breadth: an iPad asking for the desktop site carries "Macintosh",
        // and every Android UA carries "Linux". So Apple is matched first, and
        // Android is ruled out before the Linux test — which leaves phones on
        // the Windows default they already had, and is the right answer for a
        // desktop-only download anyway.
        var p = (navigator.userAgentData && navigator.userAgentData.platform) || "";
        var s = p + " " + navigator.userAgent;
        d.dataset.os = /mac|iphone|ipad|ipod/i.test(s)
          ? "mac"
          : /linux/i.test(s) && !/android/i.test(s)
            ? "linux"
            : "win";
        // A SECOND axis, and the reason it cannot be folded into data-os: the
        // mapping above deliberately answers "which build would this reader
        // want", so it files Android under win and iPhone under mac. That is
        // right for OFFERING a build — a phone reader is usually fetching one
        // for a machine they will sit at later — and catastrophic for FIRING
        // one, because it makes every phone look like a desktop that matched.
        // Nothing may auto-download while this is set.
        if (/iphone|ipad|ipod|android|mobile/i.test(s)) d.dataset.form = "mobile";
      })();
    </script>
    {/* For a page that needs its own pre-paint work, on the same terms as the
        OS script above — anything that decides what the first frame LOOKS like
        has to run before there is one. In the head rather than at the top of
        the page body because a body script only wins that race by luck: the
        browser is free to paint the markup it has already parsed above it. */}
    <slot name="head" />
  </head>
  <body class="bg-page text-ink font-sans">
    <Nav />
    <slot />
    <Footer />
    <script>
      // Scroll reveal: the hidden state only applies under html.js, so a failed
      // script leaves the page fully visible rather than permanently blank.
      const reveals = [...document.querySelectorAll(".reveal")];
      // Pre-mark anything already on screen BEFORE the hidden state lands: on a
      // slow load first paint beats this end-of-body script, and adding `js`
      // alone would animate visible sections to transparent. `.in` and `js` in
      // one task resolve to the same computed style the element already has.
      for (const el of reveals) {
        const r = el.getBoundingClientRect();
        if (r.top < innerHeight && r.bottom > 0) el.classList.add("in");
      }
      document.documentElement.classList.add("js");
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("in");
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      reveals.forEach((el) => { if (!el.classList.contains("in")) io.observe(el); });
    </script>
  </body>
</html>
