---
import { Icon } from "astro-icon/components";
import Base from "../layouts/Base.astro";
import Chip from "../components/ui/Chip.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import { links } from "../config";
import { ENTRIES, formatDate, KIND_LABEL, releaseStrip } from "../data/changelog";

// Three render states, one per release, and which one a release gets is decided
// in data/changelog.ts rather than here. The page's only job is to make all
// three look deliberate, because on a two-day release cadence most entries will
// never be written up and a layout that only looks finished when every row has
// prose would spend the rest of its life looking broken.
//
// The version is the heading, not the date. A reader arrives here from an
// update prompt or a release URL holding a version string, and that is the
// thing they are scanning for; the date is context they read second. It is also
// what the anchor is built from, so a support reply can link at the exact build
// someone is asking about — and `article:target` below is what that reader
// lands on, because a deep link that leaves you somewhere in a stack of
// nineteen identical rules has not answered them.
//
// Newest first and no pagination. At this cadence the page has a couple of
// years before length is a real problem — by which point the answer is a year
// filter, not a page-2 nobody clicks.
const [latest] = ENTRIES;

// The cadence, drawn rather than claimed. "We release every couple of days" is
// the kind of sentence every product's changelog opens with and none of them
// evidence; the strip is the shipping record itself, so a reader decides what
// the cadence is instead of being told. It doubles as the jump: a lit tick
// links at that day's build.
//
// Counted over the WINDOW, not over ENTRIES. Once the page outlives STRIP_DAYS
// the two diverge, and the number under the axis has to be the number of marks
// above it or the strip reads as having lost some.
const strip = releaseStrip();
const shipped = strip.reduce((n, day) => n + day.releases.length, 0);
---
<Base
  title="Changelog — antgrid"
  description="Every antgrid release, newest first: what changed in each build, what it fixed, and the full generated notes for anything we haven't written up."
  path="/changelog"
>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <header class="mb-2">
      {/* Carries the count and the start of the axis rather than the word
          "changelog", which the h1 under it is already saying. It is also what
          makes the strip legible without a legend: the number of builds and the
          date the marks start are stated, so the marks only have to show the
          distribution. */}
      {strip.length > 0 && (
        <Eyebrow class="mb-4">{shipped} build{shipped === 1 ? "" : "s"} since {formatDate(strip[0].date)}</Eyebrow>
      )}
      <h1 class="mb-5 font-display text-title font-semibold text-ink">Changelog</h1>
      {/* Sets expectations for the two states that are not prose, in the order a
          reader meets them, so a run of link-only entries further down reads as
          a policy rather than as a page someone stopped maintaining. */}
      <p class="max-w-[46rem] text-lede text-muted">
        Every build we ship, newest first. Where one only moved plumbing around we say so rather
        than dressing it up, and where we haven't written it up the full generated list is one
        link away.
      </p>

      {strip.length > 0 && (
        // One tick per day across the shipping window, lit on the days a build
        // went out. Ticks rather than a week grid on purpose: seven columns of
        // squares is a contribution graph, which is a picture of a person's
        // habits, and this is a picture of a machine's output.
        //
        // Idle days are drawn, not skipped. The gaps are the information — a
        // strip of only the days we shipped would be a list of release dates,
        // which the ledger below already is.
        //
        // The marks stand on the ledger's own head rule rather than on a rule
        // of their own: ticks on an axis are a measurement, the same run
        // floating is a barcode, and a second rule two lines above the first
        // would be a ruled band with nothing in it. Gap at least the width of a
        // tick for the same reason — abutting marks merge into bars and the
        // empty days stop counting as days.
        //
        // A tick is a fixed width and the strip is only as wide as it needs to
        // be: left to fill the measure, the marks would be spaced by the
        // viewport, which is not one of the things being measured. Ticks still
        // shrink rather than overflow, so the far end of STRIP_DAYS narrows the
        // marks instead of running off the page.
        <ul
          class="mt-9 flex w-fit max-w-full items-end gap-[5px]"
          aria-label={`Days we shipped, from ${formatDate(strip[0].date)}`}
        >
          {strip.map((day) => (
            <li class="h-7 w-[5px]">
              {day.releases.length > 0 ? (
                <a
                  href={`#${day.releases[0].version}`}
                  class="block size-full bg-signal/70 transition-colors hover:bg-signal"
                >
                  {/* The tick is five pixels of colour, so its name is the whole
                      affordance for anyone not pointing at it. */}
                  <span class="sr-only">
                    {day.releases.length > 1
                      ? `${day.releases.length} builds on ${formatDate(day.date)}`
                      : `${day.releases[0].version}, ${formatDate(day.date)}`}
                  </span>
                </a>
              ) : (
                <span aria-hidden="true" class="block size-full bg-edge-inner"></span>
              )}
            </li>
          ))}
        </ul>
      )}
    </header>

    {/* Head rule heavier than the row rules, as everywhere else on the site: the
        eye finds the top of a record before it starts reading down it. */}
    <div class="border-t border-edge-emph">
      {ENTRIES.map((entry) => (
        <article id={entry.version} class="cl-entry scroll-mt-28 border-b border-edge-inner py-7">
          {/* Version, date and the link out on one rule across the full measure.
              Held in a rail beside the prose they cost a third of the width to
              say three short things, and the prose paid for it in wraps. */}
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
            <h2 class="font-mono text-row">
              {/* The anchor is on the version itself rather than on a hover
                  glyph beside it. This page's readers arrive from support
                  replies and update prompts, so the deep link is the point of
                  the row, not an affordance for people who already know the
                  convention. */}
              <a href={`#${entry.version}`} class="cl-version relative text-ink2 transition-colors hover:text-signal">{entry.version}</a>
            </h2>
            <p class="font-mono text-meta text-muted2">{formatDate(entry.date)}</p>
            {entry === latest && <Chip>latest</Chip>}
            {/* On every entry, including the written ones: the notes below are a
                selection, and a reader chasing a specific fix needs the full
                list rather than our edit of it. Sits on the header rule rather
                than under the prose because it is the release's metadata, not a
                conclusion to the writing.

                Pushed to the far end of the rule only once the rule is long
                enough to have two ends. Wrapped onto a line of its own on a
                phone it would be a right-aligned orphan under a left-aligned
                row, which reads as a layout fault rather than as an anchor. */}
            <a
              href={entry.url}
              aria-label={`Full generated notes for ${entry.version} on GitHub`}
              class="inline-flex items-center gap-1.5 text-meta text-muted2 transition-colors hover:text-ink sm:ml-auto"
            >
              <Icon name="tabler:brand-github" width="14" height="14" />
              Full notes
            </a>
          </div>

          {entry.note?.title && (
            <h3 class="mt-5 font-display text-kicker font-semibold text-ink">{entry.note.title}</h3>
          )}

          {entry.note ? (
            // A list, because that is what it is: one item per change worth a
            // stranger's attention. Run together as paragraphs a seven-line
            // release is a slab nobody scans, and scanning is what almost
            // everyone here is doing.
            //
            // The kind sits in a gutter beside its own line rather than as a
            // heading over a group of them, so the order a release was written
            // in survives: sorted into kind order, "And this page." would open
            // the release that shipped Modelwatch. It also means the reader who
            // came for one word can run their eye down a single column instead
            // of hunting for a heading that may not be there.
            //
            // All four kinds in one colour. Green for new and red for fixed is
            // the changelog kit, and on this site it would spend `ok` and the
            // amber that means a human is needed on decoration.
            <ul class="mt-5 flex flex-col gap-3.5">
              {entry.note.lines.map(([kind, text]) => (
                <li class="grid gap-y-0.5 sm:grid-cols-[4.5rem_minmax(0,32rem)] sm:gap-x-5 sm:gap-y-0">
                  {/* Nudged onto the prose's baseline: the two sit in different
                      line boxes, and a label riding a pixel high next to sixty
                      paragraphs is the kind of thing that reads as sloppy
                      without ever being identified. */}
                  <p class="font-mono text-meta text-muted2 sm:pt-[2px]">{KIND_LABEL[kind]}</p>
                  <p class="text-note text-ink2">{text}</p>
                </li>
              ))}
            </ul>
          ) : entry.maintenance ? (
            // The release said this itself. Stated plainly rather than hidden,
            // because a missing version is a question ("did I miss one?") and
            // this answers it in a line.
            <p class="mt-5 max-w-lg text-note text-muted2">
              Maintenance build. Nothing here changes what you'd notice using it.
            </p>
          ) : (
            <p class="mt-5 max-w-lg text-note text-muted2">
              We haven't written this one up. The generated notes list every change.
            </p>
          )}
        </article>
      ))}
    </div>

    <div class="mt-12">
      <p class="max-w-lg text-note text-muted">
        Running an older build? The app checks for new ones and tells you when there is one, or you
        can{" "}<a href={links.download} class="text-signal hover:text-signal2 hover:underline">download the latest</a>{" "}directly.
      </p>
    </div>
  </main>
</Base>

<style>
  /* What a deep link is for. Arriving at #v1.20706.1015 with nothing marked
     leaves the reader counting rules, and a support reply that says "fixed in
     1015" is only as good as the row it lands on.
     Absolutely positioned so nothing in the ledger moves when a row is
     targeted: nineteen rules shifting by a marker's width would be the loudest
     thing on the page. */
  .cl-entry:target .cl-version {
    color: var(--color-signal);
  }
  .cl-entry:target .cl-version::before {
    content: "";
    position: absolute;
    left: -1rem;
    top: 0.15em;
    width: 0.5em;
    height: 1.05em;
    background: var(--color-signal);
  }
</style>
