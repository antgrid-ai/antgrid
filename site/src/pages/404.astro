---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found — antgrid" description="That page doesn't exist." path="/404">
  <section class="mx-auto max-w-3xl px-6 py-24 text-center">
    <p class="mb-3 font-mono text-marker uppercase tracking-[0.18em] text-signal">404</p>
    <h1 class="mb-3 font-display text-title font-semibold text-ink">Page not found.</h1>
    <p class="text-muted">That page doesn't exist. <a class="text-signal underline" href="/">Head back home</a>.</p>
  </section>
</Base>
