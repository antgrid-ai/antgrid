---
import { Icon } from "astro-icon/components";
import Base from "../../layouts/Base.astro";
import Button from "../../components/ui/Button.astro";
import Mark from "../../components/ui/Mark.astro";
import { links, offerUrlFor, PLATFORMS } from "../../config";

// Both axes of PLATFORMS, serialised as one table for the head script: `os` is
// what the reader's own machine reports and `url` is what firing means, and the
// script needs the pair together to answer "did this URL ask for a build this
// reader can actually run". Derived rather than written out, so an id still
// only ever exists in config.ts.
//
// `<` is escaped on the way out because JSON.stringify does not escape it and
// set:html inserts this verbatim: the HTML tokenizer ends a <script> at the
// first `</script` in its raw text no matter what quoting it sits inside, so a
// URL that ever contained one would close the tag and parse the rest of the
// page's head as markup. < is the same character to a JS parser.
const SCRIPT_BUILDS = JSON.stringify(
  Object.fromEntries(PLATFORMS.map((p) => [p.id, { os: p.os, url: p.url }]))
).replace(/</g, "\\u003c");

// The one instruction that cannot wait behind a click. Everything else on this
// page routes into the guide; this does not, because the reader is holding the
// file right now and a .dmg or an AppImage does not install itself. Windows is
// the short one on purpose — it is a Store installer, so there is nothing to do
// but run it, and padding it out to match its siblings would invent a step.
const INSTALL = {
  windows: { file: "the Microsoft Store installer", step: "Run it, then launch antgrid from the Start menu." },
  macos: { file: "antgrid-macos.dmg", step: "Open it and drag antgrid into Applications." },
  linux: { file: "antgrid-linux.AppImage", step: "Make it executable, then run it:" },
};
const BUILDS = PLATFORMS.map((p) => ({ ...p, ...INSTALL[p.id as keyof typeof INSTALL] }));

// Numbered because this genuinely is a sequence — you cannot connect a phone to
// a machine with no project open — and because each card is the guide's own
// step, in the guide's own order. They carry NO instructions, only a one-line
// description and a link: the guide stays the single place any of this is
// written down, so the two cannot drift into disagreeing with each other.
const STEPS = [
  {
    n: "01",
    title: "Install and sign in",
    body: "Email magic link, GitHub or Google. That account is what links your devices together — there is nothing else to set up.",
    href: `${links.getStarted}#install`,
  },
  {
    n: "02",
    title: "Open a project, start your agent",
    body: "Claude Code, Codex, Cursor — whatever you already run. antgrid wraps the real terminal, so nothing about your workflow changes.",
    href: `${links.getStarted}#project`,
  },
  {
    n: "03",
    title: "Connect your phone",
    body: "Sign in on mobile with the same account and your computer appears on its own. No pairing step, no QR code.",
    href: `${links.getStarted}#phone`,
  },
];
---
<Base
  title="Download antgrid — Windows, macOS & Linux"
  description="Get the antgrid desktop app for Windows, macOS or Linux, then open a project and connect your phone. Free while in beta."
  path="/download"
>
  {/* Download links across the site carry ?platform=<id>, and this is what turns
      one into an actual download. It fires ONLY when the id names a build this
      reader's own machine can run. The Windows URL is a Store stub that answers
      Content-Disposition: attachment to every caller with no sniffing, so a
      Windows link that has travelled — forwarded, bookmarked, pasted into a
      group chat — would otherwise land an 815KB .exe on a Mac or a phone while
      this page congratulated them on it. A build the reader cannot run is named
      and offered as a link instead, and the page stays in its honest
      pick-a-build state; an unknown platform still does nothing at all.

      In the head (Base.astro's `head` slot) because it decides which half of
      this page exists: run a frame later and the reader sees "Download antgrid"
      swap under them into "Your download has started". It reads `data-os` from
      the layout's own head script, which is a few lines above it for the same
      reason. */}
  <script slot="head" is:inline set:html={`(function () {
  var builds = ${SCRIPT_BUILDS};
  var url = new URL(location.href);
  var platform = url.searchParams.get("platform");
  // hasOwnProperty rather than a truthy lookup: "?platform=constructor" finds a
  // value on Object's prototype, and this test is what stands between a
  // stranger's URL and a download.
  if (!platform || !Object.prototype.hasOwnProperty.call(builds, platform)) return;
  var build = builds[platform];

  // The reader's machine, not the URL's claim. Both sides of this comparison
  // come from PLATFORMS, so the two vocabularies — win/mac/linux against
  // windows/macos/linux — cannot drift apart here.
  //
  // data-form is checked as well as data-os, and checking data-os alone would
  // miss the worst case entirely: Base.astro files Android under "win" and
  // iPhone under "mac", so a phone does not read as a mismatch — it reads as a
  // match. Unguarded, the primary CTA hands an iPhone a 94MB .dmg it can never
  // open. A phone is offered the build, never fired one.
  var d = document.documentElement;
  if (build.os !== d.dataset.os || d.dataset.form === "mobile") {
    d.dataset.ask = platform;
    return;
  }

  d.dataset.dl = platform;

  // Spend the parameter before firing rather than after: a reload, or a Back
  // onto this history entry, must not fetch a second installer. The branch
  // above keeps it — nothing was fetched, so there is nothing to spend, and a
  // reader who reloads should still be told which build the link asked for.
  url.searchParams.delete("platform");
  history.replaceState(null, "", url.pathname + url.search + url.hash);

  // On load rather than during parse — a navigation issued mid-parse can cancel
  // the very page it was meant to decorate. All three URLs answer with
  // Content-Disposition: attachment, which is the whole reason this downloads
  // instead of throwing the reader off the page; a build served inline would
  // navigate away instead, and nothing here would look wrong.
  //
  // pagehide cancels the pending timer, and that is not tidiness: a reader who
  // hits Back inside the 600ms leaves a FROZEN timer behind, and bfcache
  // resumes it on the Forward — firing a download minutes later with no gesture
  // anywhere near it. Cancelling on the way out is what bounds the fire to the
  // visit it belongs to.
  addEventListener("load", function () {
    var t = setTimeout(function () { location.href = build.url; }, 600);
    addEventListener("pagehide", function () { clearTimeout(t); }, { once: true });
  });
})();`}></script>

  <main class="relative mx-auto max-w-shell px-6 pt-16 pb-24 md:pt-24">
    {/* The same glow the closing CTA uses, and the only decoration on the page:
        this is a moment, not a section, so it gets one warm centre and nothing
        else competing with it. */}
    <div class="pointer-events-none absolute -top-32 left-1/2 h-[420px] w-[640px] -translate-x-1/2 glow-signal" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-xl text-center">
      <Mark class="mx-auto mb-7 h-10 w-auto text-signal" />

      {/* Two headlines ship and the script reveals one, the same unlayered CSS
          swap as the hero's download buttons. The idle one is the default, so a
          reader with no script — or no platform — gets the working page rather
          than a thank-you for a download that never happened.

          Only ONE of them is the <h1>, and it is the idle one. Both were h1s
          while this page was noindex and it cost nothing; on an indexable page
          the raw HTML would carry two, with "Your download has started" first —
          the exact string this page must never be found by. The fired line is a
          status message about a transient client-side state, not the document's
          heading, so a <p> at heading size is what it actually is. */}
      <p class="dl-fired font-display text-title font-semibold tracking-tight text-ink">
        Your download has started.
      </p>
      <h1 class="dl-idle font-display text-title font-semibold tracking-tight text-ink">
        Download antgrid.
      </h1>

      {BUILDS.map((b) => (
        <div class={`dl-note dl-note-${b.id} mt-6 rounded-lg border border-signaldeep2 bg-signaldeep/25 px-5 py-4 text-left`}>
          <p class="flex items-center gap-2 font-mono text-marker text-signal2">
            <Icon name={b.icon} width="13" height="13" />{b.file}
          </p>
          <p class="mt-2 text-note text-ink2">{b.step}</p>
          {/* The filename comes from `b.file`, not retyped: a command the reader
              pastes has to name the file that actually landed, and the two
              agreeing is otherwise nothing but memory. */}
          {b.id === "linux" && (
            <pre class="mt-2.5 overflow-x-auto rounded border border-edge-inner bg-well px-3 py-2 font-mono text-meta text-muted"><code>chmod +x {b.file}
./{b.file}</code></pre>
          )}
          {/* The reason this box exists. The download failing is the one outcome
              that never announces itself — a browser blocks it, an extension
              eats it — and the reader is left on a page insisting it worked. */}
          <p class="mt-3 text-meta text-muted2">
            Nothing happened? <a href={b.url} class="text-signal2 hover:text-signal">Start the download manually</a>.
          </p>
        </div>
      ))}

      <div class="dl-idle">
        {/* All three ship and `data-ask` reveals one — the same unlayered swap
            as the panels above, keyed the same way on the build that was ASKED
            for. This is the honest answer to a link that has travelled: say
            which build it wanted and hand it over, rather than firing an
            installer at a machine that cannot open it. Windows resolves to the
            Store listing here for the reason the list below gives. */}
        {PLATFORMS.map((p) => (
          <p class={`dl-ask dl-ask-${p.id} mx-auto mt-6 max-w-md rounded-lg border border-edge bg-panel/50 px-5 py-3.5 text-note text-ink2`}>
            That link asked for the {p.name} build —{" "}
            <a href={offerUrlFor(p)} class="text-signal2 hover:text-signal">get it here</a>, or take yours below.
          </p>
        ))}

        <p class="mx-auto mt-5 max-w-md text-lede text-muted">
          One app for every agent on every machine you own. Free while in beta, no card required.
        </p>
        {/* One OS-matched button, not three equal ones: arriving with nothing is
            the ordinary case for a linked destination, the match is right for
            nearly everyone, and the row under it covers the rest. Same reveal as
            the hero's buttons — all three ship, global.css shows the one this
            machine can install, Windows with no script at all.

            Aimed at the artifact, never at ?platform=. Chrome's download
            protection has a no-warning path that requires a user gesture on the
            request that STARTED the download, and a location.href fired from a
            load handler carries none — so routing this button through the query
            would make Safe Browsing warn on our own installer MORE often than a
            plain click does. There is also nothing left to orient the reader to:
            they are already on the download page.

            `dl-direct` is what makes aiming at the raw artifact safe, and it is
            the only place on the site that needs it. Everywhere else a dl-os
            button goes through ?platform=, where the head script re-checks the
            machine; here there is no second check, and data-os alone would not
            survive one — it answers "which build to OFFER", so it files Android
            under win and iPhone under mac and falls through to Windows when no
            script ran at all. Unqualified, the page's one primary action would
            hand an iPhone a 94MB .dmg and an Android phone the Store's Windows
            stub, which serves a .exe to every caller that asks. */}
        <div class="dl-direct mt-7 flex flex-wrap items-center justify-center gap-3">
          {PLATFORMS.map((p) => (
            <Button href={p.url} variant="primary" class={`dl-os dl-${p.os}`}>
              <Icon name={p.icon} width="16" height="16" />Download for {p.name}
            </Button>
          ))}
        </div>

        {/* What a phone gets in that row's place. It carries no invite link of
            its own — the one below is visible in every state and a second copy
            two paragraphs apart reads as a page that lost its place. This says
            only the thing the missing button would otherwise have implied
            wrongly: the builds are for another machine. */}
        <p class="dl-handheld mx-auto mt-7 max-w-md rounded-lg border border-edge bg-panel/50 px-5 py-3.5 text-note text-ink2">
          antgrid runs on the computer your agents run on, so there is nothing to
          install on this device — take a build below for the machine you work
          on.
        </p>
      </div>

      {/* Visible in both states, not folded into .dl-idle: idle it is the escape
          hatch for the OS match, and after a download has fired it is where a
          reader collecting the build for the OTHER machine on their desk looks.

          offerUrlFor, so Windows resolves to the Store LISTING rather than the
          stub installer — that installer hands a .exe to every caller that asks,
          which is exactly what a list offered to all three OSes must not do. The
          listing is an ordinary page everywhere and still opens the Store app on
          Windows, so one anchor serves both readers and this row needs no OS
          reveal of its own.

          The id is a test hook: contracts.spec.ts pins what this row offers, and
          without it the only way to find the row was to sweep every anchor and
          subtract the ones that were not it — which the hidden dl-ask links, who
          carry these same three hrefs, quietly satisfied whether this row
          existed or not. */}
      <p id="allBuilds" class="mt-7 text-meta text-muted2">
        All builds: {PLATFORMS.map((p, i) => (
          <>{i > 0 && <span class="text-faint"> · </span>}<a href={offerUrlFor(p)} class="text-signal2 hover:text-signal">{p.name}</a></>
        ))}
      </p>

      {/* Ships empty and hidden; the script at the foot of this page fills it in
          if GitHub answers. */}
      <p id="release" class="mt-2 font-mono text-marker text-faint" hidden></p>

      {/* A phone is a normal visitor to a download URL and three desktop builds
          is the wrong answer for one, so the offer the home page closes on has
          to exist here too — this is the page where it lands on a reader who
          cannot use anything else on it. */}
      <p class="mt-3 text-meta text-muted2">
        On a phone? iOS &amp; Android are in private beta — <a href={links.mobileInvite} class="text-signal2 hover:text-signal">request an invite</a>.
      </p>
    </div>

    <section class="relative mx-auto mt-16 max-w-4xl md:mt-20">
      <p class="mb-5 text-center font-mono text-marker uppercase tracking-[0.16em] text-faint">
        What happens next
      </p>
      {/* An <ol> because the order is the content, not the styling — and the
          markers are drawn rather than left to the list, since they carry the
          card's accent and a list-item marker cannot. */}
      <ol class="grid gap-3 md:grid-cols-3">
        {STEPS.map((s) => (
          <li>
            <a
              href={s.href}
              class="group flex h-full flex-col rounded-lg border border-edge bg-panel/50 p-5 transition-colors duration-200 motion-reduce:transition-none hover:border-edge-emph hover:bg-panel"
            >
              <span class="font-mono text-marker tracking-[0.14em] text-signal2">{s.n}</span>
              <h2 class="mt-3 text-note font-medium text-ink">{s.title}</h2>
              <p class="mt-2 text-meta leading-relaxed text-muted">{s.body}</p>
              {/* mt-auto, so the three arrows line up across cards whose copy
                  runs to different depths. */}
              <span class="mt-auto inline-flex items-center gap-1.5 pt-4 text-meta text-muted2 transition-colors duration-200 motion-reduce:transition-none group-hover:text-signal2">
                Read this step<Icon name="tabler:arrow-right" width="12" height="12" />
              </span>
            </a>
          </li>
        ))}
      </ol>

      {/* Deliberately not a fourth card and not numbered 04: the three above are
          a sequence the reader has to walk, this is an aside they are free to
          ignore, and shaping it like a step would claim otherwise. It sits on
          this page and nowhere else, below the fold — a reader has either just
          been handed their build or is one click from it, and an ask any higher
          would be asking to be paid before delivering.

          "Source-available", not "open source". Most of the tree is ELv2 (see
          LICENSING.md); only the wire and relay-client packages are Apache. A
          reader who clicks through expecting MIT is a reader we misled, and this
          is the page where we are asking them for something. */}
      <a
        href={links.repo}
        class="group mt-3 flex items-center gap-4 rounded-lg border border-edge bg-panel/50 p-5 transition-colors duration-200 motion-reduce:transition-none hover:border-edge-emph hover:bg-panel"
      >
        <Icon
          name="tabler:brand-github"
          class="shrink-0 text-muted2 transition-colors duration-200 motion-reduce:transition-none group-hover:text-ink"
          width="20"
          height="20"
        />
        <span class="min-w-0 flex-1">
          <span class="block text-note font-medium text-ink">Star antgrid on GitHub</span>
          <span class="mt-1 block text-meta leading-relaxed text-muted">
            The bridge, the relay and both apps are source-available — protocol, crypto client and all. Stars are how the next person finds it.
          </span>
        </span>
        <span class="hidden shrink-0 items-center gap-1.5 text-meta text-muted2 transition-colors duration-200 motion-reduce:transition-none group-hover:text-signal2 sm:inline-flex">
          Star<Icon name="tabler:star" width="12" height="12" />
        </span>
      </a>

      <p class="mt-8 text-center text-meta text-muted2">
        The <a href={links.getStarted} class="text-signal2 hover:text-signal">setup guide</a> covers all three end to end ·
        Stuck? <a href={links.support} class="text-signal2 hover:text-signal">Support</a>
      </p>
    </section>
  </main>
</Base>

<script>
  // In the browser, never at build time. config.ts pins every download URL at
  // `releases/latest/...` precisely so cutting a release never requires a site
  // deploy — baking a tag into the HTML would hand that requirement straight
  // back, and every release would ship a page naming the previous one until
  // someone remembered to redeploy.
  //
  // Strictly additive: the element ships empty and hidden, and only a complete
  // answer unhides it. The unauthenticated API is 60 requests an hour per IP, so
  // being rate-limited is a normal outcome rather than an incident — a page that
  // simply does not mention a version reads as deliberate, where a half-written
  // line or a spinner that never resolves reads as broken.
  const el = document.getElementById("release");
  if (el) {
    fetch("https://api.github.com/repos/antgrid-ai/antgrid/releases/latest", {
      headers: { Accept: "application/vnd.github+json" },
    })
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((rel) => {
        if (!rel?.tag_name || !rel?.html_url) return;
        // Falsiness first, then NaN: `new Date(undefined)` is Invalid Date and
        // guarded, but `new Date(null)` is the epoch, so a release with a null
        // published_at would date itself 1 Jan 1970 rather than say nothing.
        const at = rel.published_at ? new Date(rel.published_at) : null;
        // The reader's locale, not ours: this is a date on a page about their
        // machine, and Intl already knows the order their country writes it in.
        const when = !at || Number.isNaN(at.getTime())
          ? ""
          : at.toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" });
        // Composed as nodes rather than innerHTML — the strings are GitHub's,
        // not ours, and this is the one place on the site that renders text
        // fetched at runtime.
        el.textContent = when ? `${rel.tag_name} · released ${when} · ` : `${rel.tag_name} · `;
        const notes = document.createElement("a");
        notes.href = rel.html_url;
        notes.className = "text-signal2 hover:text-signal";
        notes.textContent = "Release notes";
        el.append(notes);
        el.hidden = false;
      })
      .catch(() => {});
  }
</script>
