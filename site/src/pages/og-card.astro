---
import "../styles/global.css";
import ProofCard from "../components/sections/ProofCard.astro";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
  </head>
  <body class="bg-page">
    <div id="og" style="width:1200px;height:630px" class="flex flex-col justify-center gap-6 bg-page px-20">
      {/* A compression of the hero headline, not a copy: the card is a fixed
          1200x630 and the hero's second line would push the ProofCard past the
          bottom edge. Keep the claim identical and the line count at two. */}
      <div>
        <p class="mb-3 font-mono text-lg uppercase tracking-[0.18em] text-indigo">antgrid</p>
        <p class="mb-2 max-w-3xl text-3xl font-medium leading-tight text-muted">Your agent finishes a phase at 2am and waits.</p>
        <p class="max-w-3xl text-5xl font-medium leading-tight text-ink">antgrid starts the next one.</p>
      </div>
      <div class="max-w-xl"><ProofCard /></div>
    </div>
  </body>
</html>
