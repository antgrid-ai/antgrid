    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
  </head>
  <body class="bg-page">
    <div id="og" style="width:1200px;height:630px" class="flex flex-col justify-center gap-6 bg-page px-20">
      <div>
        <p class="mb-3 font-mono text-lg uppercase tracking-[0.18em] text-indigo">antgrid</p>
        <p class="mb-2 max-w-2xl text-3xl font-medium leading-tight text-muted">Your agent says it's done.</p>
        <p class="max-w-2xl text-5xl font-medium leading-tight text-ink">Make it prove it.</p>
      </div>
      <div class="max-w-xl"><ProofCard /></div>
    </div>
  </body>
</html>
