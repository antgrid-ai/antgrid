---
import "../styles/global.css";
import { Font } from "astro:assets";
import ProofCard from "../components/sections/ProofCard.astro";
import Wordmark from "../components/ui/Wordmark.astro";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    {/* This page does not use Base, and the @font-face rules now come from the
        Fonts API rather than a CSS @import — so without these the card would
        screenshot in the system fallback. preload because the shot is taken as
        soon as the page settles and a swapped-in face would land too late. */}
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains" preload />
  </head>
  <body class="bg-page">
    {/* justify-start with a measured top pad, not justify-center: the content is
        close enough to 630px that centering clips BOTH edges, and the one row
        that must never be cut is the amber wake at the card's bottom. */}
    <div id="og" style="width:1200px;height:630px" class="flex flex-col items-center justify-start gap-4 bg-page pt-7">
      {/* Type and card share one 39rem column so the composition stays centred —
          left-anchoring the way the hero does leaves a third of this canvas dead,
          which reads as overflow rather than intent at thumbnail size. */}
      {/* The hero headline, and it stands on its own the way the copy before it
          did not: "antgrid starts the next one." needed a setup line above it to
          mean anything, which is why this card used to carry one. It does not
          need one now, and the ProofCard below already supplies the 2am story
          that line was telling — it timestamps 02:58 and says "While you slept".

          Two text lines is the budget, not a preference: the card is a fixed
          1200x630 and the ProofCard's amber wake sits on the bottom edge with no
          slack, so a third line clips it. Dropping the setup line is what buys the
          headline its second. */}
      <div class="w-[39rem]">
        {/* Sizes stay explicit here rather than using the fluid display scale —
            this canvas is a fixed 1200x630, so there is no viewport for it to
            respond to. */}
        {/* The real wordmark, not letterspaced mono standing in for it — a link
            preview is the one place the brand is seen before the site is. Bare
            wordmark rather than the lockup because the reduction rule wants ~40px
            before the four chevrons separate, and h-6 keeps this line the same
            height the type it replaced occupied (the composition below has no
            slack: the amber wake sits on the bottom edge). */}
        <Wordmark class="mb-2.5 h-6 w-auto text-signal" />
        {/* inline-block per sentence, as in the hero, so the two lines break
            between sentences rather than wherever 39rem happens to fall. 2.5rem
            rather than the hero's fluid scale: this headline is a sentence longer
            than the one it replaced, and "Your machines. Your agents." has to
            clear this column on one line — at 2.75rem it does not, and the third
            line that buys costs the amber wake its place on the bottom edge. */}
        <p class="font-display text-[2.5rem] font-semibold leading-[1.05] tracking-[-0.032em] text-ink">
          <span class="inline-block">Your machines.</span>{" "}
          <span class="inline-block">Your agents.</span>{" "}
          <span class="inline-block">One control plane.</span>
        </p>
      </div>
      {/* 39rem, not max-w-xl: wide enough that the snapshot row stops wrapping to
          two lines (which pushed the amber wake past the bottom edge) and still
          under the card's 42rem two-column container query, which would split it. */}
      <div class="w-[39rem]"><ProofCard /></div>
    </div>
  </body>
</html>
