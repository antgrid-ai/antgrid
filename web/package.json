{
  "name": "antgrid-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run build:assets && concurrently -k -n server,assets -c blue,magenta \"bun run dev:server\" \"bun run dev:assets\"",
    "dev:server": "bun run --watch src/index.ts",
    "dev:assets": "vite build --watch",
    "build:assets": "vite build",
    "build": "bun run build:assets",
    "start": "bun run src/index.ts",
    "pretest": "bun run prisma:generate && bun run build:assets",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "migrate": "bunx --bun prisma@6 migrate deploy",
    "prisma:generate": "bunx --bun prisma@6 generate",
    "prisma:migrate:dev": "bunx --bun prisma@6 migrate dev",
    "prisma:migrate:deploy": "bunx --bun prisma@6 migrate deploy",
    "postinstall": "bunx --bun prisma@6 generate",
    "generate:key": "bun run scripts/generate-signing-key.ts",
    "reconcile:seats": "bun run scripts/reconcile-seats.ts"
  },
  "dependencies": {
    "@better-auth/core": "^1.6.9",
    "@better-auth/oauth-provider": "^1.6.11",
    "@better-auth/prisma-adapter": "^1.6.9",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@noble/ed25519": "^2.1.0",
    "antgrid-wire": "workspace:*",
    "@noble/hashes": "^1.5.0",
    "@paddle/paddle-js": "^1.6.4",
    "@paddle/paddle-node-sdk": "^3.8.0",
    "@prisma/adapter-pg": "^6",
    "@prisma/client": "^6",
    "better-auth": "^1.0.0",
    "dotenv": "^17.4.2",
    "hono": "^4.6.0",
    "jose": "^6.2.2",
    "pg": "^8",
    "postgres": "^3.4.4",
    "razorpay": "2.9.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@tailwindcss/vite": "^4.2.4",
    "@types/bun": "^1.2.4",
    "@types/pg": "^8.20.0",
    "concurrently": "^9.2.1",
    "daisyui": "^5.5.19",
    "htmx.org": "2.0.4",
    "prisma": "^6",
    "tailwindcss": "^4.2.4",
    "typed-htmx": "^0.3.1",
    "typescript": "^5.7.3",
    "vite": "^6"
  }
}
