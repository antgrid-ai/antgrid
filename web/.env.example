# Environment — development | test | staging | production. Defaults to development.
NODE_ENV=development

# Postgres
PG_DATABASE_URL=postgres://postgres:postgres@localhost:5432/antgrid_license

# Better-Auth manages its own signing key in the DB; no JWT seed required.
# Also the key stored OAuth provider tokens are encrypted with: changing it signs
# everyone out AND leaves those tokens unreadable, so Apple tokens can no longer
# be revoked on account deletion until each user signs in again.
BETTER_AUTH_SECRET=
# Optional in dev/test (auto-derives to http://localhost:${PORT}). Required in production.
BETTER_AUTH_URL=

# OAuth providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub App (issue import). Optional: leave any of these empty and the service
# still boots, with the integrations page saying there is no App to connect.
# NOT the GITHUB_CLIENT_* pair above - those sign users in, these belong to the
# App itself. Register the App with "Request user authorization (OAuth) during
# installation" or no code reaches the callback and no install can be verified.
# The private key signs for every installation across every tenant: keep it here
# or in a secret manager, never in the repo. Its newlines may be written escaped.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
# Sign in with Apple — optional, but all four or none. APPLE_CLIENT_ID is the
# Services ID; APPLE_PRIVATE_KEY is the .p8 PEM (escape newlines as \n to keep
# it on one line). APPLE_APP_BUNDLE_ID defaults to ai.radhaai.antgrid.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Email (magic-link) — omit to use console logger in dev.
# ZeptoMail "Send Mail" token (bare key; the Zoho-enczapikey prefix is added in code).
ZEPTOMAIL_TOKEN=
# Switch to no-reply@antgrid.ai only after sender/DKIM/return-path/DMARC gates.
EMAIL_FROM="Antgrid <no-reply@radhaai.org>"
EMAIL_REPLY_TO=contact@radhaai.com
# Dedicated AES-GCM keyring. Each value is a base64-encoded random 32-byte key.
# Production requires this keyring, active version, provider and webhook secret.
# Keep previous versions until every queued job has drained.
EMAIL_OUTBOX_KEYS=
EMAIL_OUTBOX_ACTIVE_KEY=
EMAIL_DELIVERY_PAUSED=false
ZEPTOMAIL_WEBHOOK_SECRET=
# Disable after updated clients ship and legacy tokens drain (three minutes).
LEGACY_NATIVE_OAUTH_ISSUANCE=true
LEGACY_NATIVE_OAUTH=true

# Optional — relay push. Skipped if unset.
RELAY_INTERNAL_URL=
RELAY_INTERNAL_SECRET=

# Bearer token the stock iroh-relay's access.http check presents back to us.
# The relay side reads the same value as IROH_RELAY_HTTP_BEARER_TOKEN. Aspire
# generates one per run.
PEER_RELAY_ACCESS_TOKEN=

# Approved public Iroh relay HTTPS origins; leave empty until qualified.
IROH_RELAY_URLS=
# Private signed revocation delivery targets: JSON [{url, secret}], each url a
# central relay's /internal/peer-policy (anything else fails the boot).
# Configure through deployment secrets.
PEER_POLICY_TARGETS=[]

# Reverse proxies whose X-Forwarded-For we may believe (comma-separated
# IPs/CIDRs — the antgrid_edge subnet in deploy). Unset/empty means the header
# is ignored, which is what a directly exposed server wants. Same contract and
# same loader as the relay's TRUSTED_PROXY_IPS.
TRUSTED_PROXY_IPS=

# Billing secrets — set on staging/live VMs. Local dev: optional in web/.env.
# Plan/price IDs and public keys: web/src/config/billing.ts
# Aliases also accepted: PaddleApiKey, RazorpayKeySecret, RazorpayWebhookSecret, IPinfoAccessToken
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# RAZORPAY_KEY_ID must pair with RAZORPAY_KEY_SECRET (id+secret are one key).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
IPINFO_TOKEN=

# Dev-only: mount POST /dev/billing/subscription to set a subscription without
# a real payment/webhook. Ignored unless NODE_ENV is non-production. NEVER set
# this on staging/live. Accepts only "true"/"false".
DEV_BILLING_ENABLED=false

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:4321,https://antgrid.ai

# Port
PORT=8787
# Optional override for the committed SalesIQ widget URL. The script is still
# loaded only after the signed-in user chooses Support.
SALESIQ_WIDGET_URL=https://salesiq.zohopublic.com/widget?wc=siq1b947f921d212e33194fb74467bb4e1d9243576c0c0fc99198af56f9bc127661
