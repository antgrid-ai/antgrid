# Copy to backend.hcl and fill in, then: tofu init -backend-config=backend.hcl
# Points OpenTofu state at an Azure Blob container (NOT a SaaS). Bootstrap the
# storage account once — see infra/tofu/README.md "State backend".
# backend.hcl is gitignored (it names your storage account, not secrets).

resource_group_name  = "antgrid-tfstate"
storage_account_name = "antgridtfstate"   # globally unique, 3-24 lowercase alphanumerics
container_name       = "tfstate"
# Environment-neutral base key. Workspaces isolate per-environment state inside
# the same container (prod -> "<key>env:prod", staging -> "<key>env:staging").
# Select the environment with: tofu workspace select -or-create prod|staging
key                  = "antgrid.tfstate"
# use_oidc = true   # set in CI; locally az login is enough
