# Files that are executed or consumed on Linux (CI runners, container images)
# must keep LF line endings even when committed from Windows — a CRLF in a shell
# script breaks the shebang, and CRLF in a Dockerfile is fragile.
*.sh        text eol=lf
Dockerfile  text eol=lf

# Flutter regenerates these with LF on every build regardless of host OS, so a
# CRLF checkout (core.autocrlf=true on Windows) leaves them permanently dirty.
# Only the *.h are tracked; the .cc/.cmake siblings are gitignored.
generated_plugin_* text eol=lf
