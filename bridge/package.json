{
  "name": "antgrid-bridge",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile dist/antgrid --define 'process.env.LICENSE_API_URL=\"https://app.antgrid.ai\"' --define 'process.env.ANTGRID_BRIDGE_COMPILED=\"1\"'",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.201",
    "@inquirer/prompts": "^8.4.2",
    "@opencode-ai/sdk": "1.15.10",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "antgrid-wire": "workspace:*",
    "bun-pty": "^0.4.8",
    "chokidar": "^5.0.0",
    "commander": "^13.1.0",
    "ignore": "^7.0.5",
    "pino": "9.7.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.3"
  }
}
