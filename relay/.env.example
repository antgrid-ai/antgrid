# Relay environment variables.

PORT=8080
LICENSE_API_URL=http://localhost:8787
# Must match web/.env's RELAY_INTERNAL_SECRET. >= 16 chars.
RELAY_INTERNAL_SECRET=
LOG_LEVEL=info
LICENSE_CACHE_MAX_ENTRIES=100000
# Override JWKS path on web. Defaults to Better-Auth's /api/auth/jwks.
# LICENSE_API_JWKS_PATH=/api/auth/jwks

# Encrypted push (Phase 1, Android). Optional: all three enable FCM delivery of
# opaque ciphertext blobs; absent, push:deliver returns reason:"unconfigured"
# and live notifications still work. From a Firebase service-account key — see
# docs/runbooks/fcm-relay-setup.md. Keep the private key OFF every bridge.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=   # PEM; escape newlines as \n
